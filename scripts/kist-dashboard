#!/bin/bash -p
# Canonical authenticated Kist dashboard launcher. Parse first; validate deployment provenance before
# process mutation; replace only an exactly-owned, authenticated Kist listener.
set -euo pipefail
umask 077
unset ENV BASH_ENV CDPATH

readonly INSTALL_HOME="/Users/lukekist"
readonly KIST_HOME="$INSTALL_HOME/.kist"
readonly PYTHON="/usr/bin/python3"
readonly RUNTIME="$KIST_HOME/scripts/kist_runtime.py"
readonly DASHBOARD_LAUNCHER="$INSTALL_HOME/bin/kist-dashboard"
readonly DASHBOARD_REBUILD="$INSTALL_HOME/bin/kist-rebuild"
readonly SAFE_PATH="/usr/bin:/bin:/usr/sbin:/sbin"
readonly SERVICE="kist-live-dashboard"
PATH="$SAFE_PATH"
HOME="$INSTALL_HOME"
export HOME PATH

usage() {
  printf '%s\n' 'usage: kist-dashboard [control] [conversation|flow|timeline|fleet|vms|plan] [--project-root PATH] [--port PORT] [--no-open]'
}
die() { printf 'kist-dashboard: %s\n' "$*" >&2; exit 1; }

VIEW=""
PORT=7777
PROJECT_ROOT=""
CONTROL=0
NO_OPEN=0
PROJECT_SEEN=0
PORT_SEEN=0
HELP=0
EVALUATE=0
VALIDATE=0
REQUIRE_ENTERPRISE=0
EVAL_BINARY=""
EVAL_WRAPPER=""
EVAL_DASHBOARD=""
EVAL_REBUILD=""
EVAL_SAFE_REBUILD=""
EVAL_CLOSURE_VERSION=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    conversation|flow|timeline|fleet|vms|plan)
      [[ -z "$VIEW" ]] || die 'dashboard view may be supplied only once'
      VIEW="$1"; shift ;;
    control)
      [[ "$CONTROL" -eq 0 ]] || die 'control may be supplied only once'
      CONTROL=1; shift ;;
    --project-root)
      [[ "$PROJECT_SEEN" -eq 0 && $# -ge 2 && -n "$2" ]] || die '--project-root requires one value and may be supplied only once'
      PROJECT_SEEN=1; PROJECT_ROOT="$2"; shift 2 ;;
    --project-root=*)
      [[ "$PROJECT_SEEN" -eq 0 && -n "${1#--project-root=}" ]] || die '--project-root requires one value and may be supplied only once'
      PROJECT_SEEN=1; PROJECT_ROOT="${1#--project-root=}"; shift ;;
    --port)
      [[ "$PORT_SEEN" -eq 0 && $# -ge 2 ]] || die '--port requires one value and may be supplied only once'
      PORT_SEEN=1; PORT="$2"; shift 2 ;;
    --port=*)
      [[ "$PORT_SEEN" -eq 0 && -n "${1#--port=}" ]] || die '--port requires one value and may be supplied only once'
      PORT_SEEN=1; PORT="${1#--port=}"; shift ;;
    --no-open)
      [[ "$NO_OPEN" -eq 0 ]] || die '--no-open may be supplied only once'
      NO_OPEN=1; shift ;;
    -h|--help)
      [[ "$HELP" -eq 0 ]] || die '--help may be supplied only once'
      HELP=1; shift ;;
    --provenance-evaluate)
      [[ "$EVALUATE" -eq 0 ]] || die '--provenance-evaluate may be supplied only once'
      [[ $# -eq 3 || $# -eq 5 || $# -eq 6 ]] \
        || die '--provenance-evaluate requires BINARY WRAPPER [DASHBOARD REBUILD [SAFE_REBUILD]]'
      EVALUATE=1; EVAL_BINARY="$2"; EVAL_WRAPPER="$3"
      if [[ $# -eq 6 ]]; then
        EVAL_DASHBOARD="$4"; EVAL_REBUILD="$5"; EVAL_SAFE_REBUILD="$6"
        EVAL_CLOSURE_VERSION=3; shift 6
      elif [[ $# -eq 5 ]]; then
        EVAL_DASHBOARD="$4"; EVAL_REBUILD="$5"
        EVAL_CLOSURE_VERSION=2; shift 5
      else
        EVAL_CLOSURE_VERSION=2; shift 3
      fi ;;
    --provenance-validate)
      [[ "$VALIDATE" -eq 0 ]] || die '--provenance-validate may be supplied only once'
      VALIDATE=1; shift ;;
    --require-enterprise)
      [[ "$REQUIRE_ENTERPRISE" -eq 0 ]] || die '--require-enterprise may be supplied only once'
      REQUIRE_ENTERPRISE=1; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done
if [[ ! "$PORT" =~ ^[1-9][0-9]{0,4}$ ]] || (( 10#$PORT > 65535 )); then
  die '--port requires a canonical integer from 1 through 65535'
fi
if [[ "$HELP" -eq 1 ]]; then usage; exit 0; fi
if [[ "$EVALUATE" -eq 1 ]]; then
  [[ -z "$VIEW" && "$CONTROL" -eq 0 && "$NO_OPEN" -eq 0 && "$PROJECT_SEEN" -eq 0 && "$PORT_SEEN" -eq 0 ]] \
    || die '--provenance-evaluate cannot be combined with launch arguments'
  for override in "$EVAL_BINARY" "$EVAL_WRAPPER" "$EVAL_DASHBOARD" "$EVAL_REBUILD" "$EVAL_SAFE_REBUILD"; do
    [[ -z "$override" || "$override" = /* ]] || die 'provenance override paths must be absolute'
  done
fi
if [[ "$VALIDATE" -eq 1 ]]; then
  [[ "$EVALUATE" -eq 0 && -z "$VIEW" && "$CONTROL" -eq 0 && "$NO_OPEN" -eq 0 && "$PROJECT_SEEN" -eq 0 && "$PORT_SEEN" -eq 0 ]] \
    || die '--provenance-validate cannot be combined with launch arguments'
fi
if [[ "$REQUIRE_ENTERPRISE" -eq 1 && "$VALIDATE" -ne 1 ]]; then
  die '--require-enterprise is valid only with --provenance-validate'
fi
[[ -x "$PYTHON" && ! -L "$PYTHON" ]] || die "trusted system python is unavailable at $PYTHON"

python_clean() {
  /usr/bin/env -i HOME="$INSTALL_HOME" PATH="$SAFE_PATH" LANG=C LC_ALL=C \
    TMPDIR=/private/tmp PYTHONNOUSERSITE=1 "$PYTHON" -I "$@" 8>&- 9>&-
}

# Hold a kernel-backed shared deployment lease from validation through authenticated readiness.
# Rebuild takes the same file exclusively, so the bytes proven below cannot be replaced between
# validation and execution.  This shell owns the inherited open-file descriptions directly: a
# short trusted Python process applies BSD flock, exits, and leaves the lock with this process.
DEPLOY_LEASE_ACTIVE=0
DEPLOY_LEASE_IDENTITY=""
LAUNCH_LEASE_ACTIVE=0
LAUNCH_LEASE_IDENTITY=""

lease_python() {
  /usr/bin/env -i HOME="$INSTALL_HOME" PATH="$SAFE_PATH" LANG=C LC_ALL=C \
    TMPDIR=/private/tmp PYTHONNOUSERSITE=1 "$PYTHON" -I "$@"
}

prepare_lease_path() {
  python_clean - "$1" <<'PY'
import os,stat,sys
path=sys.argv[1]; uid=os.geteuid()
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
parent=os.path.dirname(path); leaf=os.path.basename(path)
if not leaf or "/" in leaf or not path.startswith("/") or os.path.realpath(parent)!=parent:
    raise SystemExit(1)
directory=os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); pins=[]
try:
    root=os.fstat(directory)
    if not stat.S_ISDIR(root.st_mode) or root.st_uid not in {0,uid} or root.st_mode&0o022:
        raise SystemExit(1)
    for part in [item for item in parent.split("/") if item]:
        named=os.stat(part,dir_fd=directory,follow_symlinks=False)
        if (not stat.S_ISDIR(named.st_mode) or named.st_uid not in {0,uid}
                or named.st_mode&0o022):
            raise SystemExit(1)
        child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=directory)
        if fp(os.fstat(child))!=fp(named):
            os.close(child); raise SystemExit(1)
        pins.append((directory,part,child,dfp(named))); directory=child
    try:
        named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    except FileNotFoundError:
        fd=os.open(leaf,os.O_RDONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,
                   dir_fd=directory)
        os.close(fd); os.fsync(directory)
        named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    if (not stat.S_ISREG(named.st_mode) or named.st_uid!=uid or named.st_nlink!=1
            or stat.S_IMODE(named.st_mode)!=0o600):
        raise SystemExit(1)
    fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=directory)
    try:
        if fp(os.fstat(fd))!=fp(named):
            raise SystemExit(1)
    finally:
        os.close(fd)
    for parent_fd,name,child_fd,identity in pins:
        if dfp(os.fstat(child_fd))!=identity:
            raise SystemExit(1)
        if dfp(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=identity:
            raise SystemExit(1)
finally:
    descriptors={directory}
    for parent_fd,_,child_fd,_ in pins:
        descriptors.update({parent_fd,child_fd})
    for descriptor in descriptors:
        os.close(descriptor)
PY
}

lease_fd_operation() {
  local action="$1" mode="$2" path="$3" fd="$4" expected="${5-}"
  lease_python - "$action" "$mode" "$path" "$fd" "$expected" <<'PY'
import fcntl,os,stat,sys,time
action,mode,path,fd_text,expected=sys.argv[1:]; uid=os.geteuid(); fd=int(fd_text)
other=8 if fd==9 else 9
try: os.close(other)
except OSError: pass
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
def lock_fp(value): return (value.st_dev,value.st_ino)
def valid_file(value):
    return (stat.S_ISREG(value.st_mode) and value.st_uid==uid and value.st_nlink==1
            and stat.S_IMODE(value.st_mode)==0o600)
parent=os.path.dirname(path); leaf=os.path.basename(path)
if action not in {"acquire","assert"} or mode not in {"shared","exclusive"} or fd not in {8,9}:
    raise SystemExit(1)
if not leaf or "/" in leaf or not path.startswith("/") or os.path.realpath(parent)!=parent:
    raise SystemExit(1)
inherited=os.fstat(fd)
if not valid_file(inherited):
    raise SystemExit(1)
directory=os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); pins=[]
try:
    root=os.fstat(directory)
    if not stat.S_ISDIR(root.st_mode) or root.st_uid not in {0,uid} or root.st_mode&0o022:
        raise SystemExit(1)
    for part in [item for item in parent.split("/") if item]:
        named=os.stat(part,dir_fd=directory,follow_symlinks=False)
        if (not stat.S_ISDIR(named.st_mode) or named.st_uid not in {0,uid}
                or named.st_mode&0o022):
            raise SystemExit(1)
        child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=directory)
        if fp(os.fstat(child))!=fp(named):
            os.close(child); raise SystemExit(1)
        pins.append((directory,part,child,dfp(named))); directory=child
    named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    named_fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=directory)
    try:
        if not valid_file(named) or fp(os.fstat(named_fd))!=fp(named):
            raise SystemExit(1)
        if lock_fp(named)!=lock_fp(inherited) or fp(os.fstat(fd))!=fp(inherited):
            raise SystemExit(1)
        identity=f"{inherited.st_dev}:{inherited.st_ino}"
        if action=="assert":
            if identity!=expected:
                raise SystemExit(1)
        else:
            deadline=time.monotonic()+30.0
            operation=(fcntl.LOCK_SH if mode=="shared" else fcntl.LOCK_EX)|fcntl.LOCK_NB
            while True:
                try:
                    fcntl.flock(fd,operation); break
                except BlockingIOError:
                    if time.monotonic()>=deadline:
                        raise SystemExit(75)
                    time.sleep(.05)
        if fp(os.fstat(fd))!=fp(inherited):
            raise SystemExit(1)
        refreshed=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
        if fp(refreshed)!=fp(named) or lock_fp(refreshed)!=lock_fp(inherited):
            raise SystemExit(1)
        for parent_fd,name,child_fd,pinned in pins:
            if dfp(os.fstat(child_fd))!=pinned:
                raise SystemExit(1)
            if dfp(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=pinned:
                raise SystemExit(1)
        print(identity)
    finally:
        os.close(named_fd)
finally:
    descriptors={directory}
    for parent_fd,_,child_fd,_ in pins:
        descriptors.update({parent_fd,child_fd})
    for descriptor in descriptors:
        os.close(descriptor)
PY
}

assert_lease() {
  local slot="$1"
  if [[ "$slot" == deployment ]]; then
    if [[ "$DEPLOY_LEASE_ACTIVE" -ne 1 ]] \
       || ! lease_fd_operation assert shared "$INSTALL_HOME/bin/.kist-deployment.lock" 9 \
            "$DEPLOY_LEASE_IDENTITY" >/dev/null; then
      die 'deployment lease descriptor is not held by this process'
    fi
  else
    if [[ "$LAUNCH_LEASE_ACTIVE" -ne 1 ]] \
       || ! lease_fd_operation assert exclusive "$RUN_DIR/dashboard-$PORT.launch.lock" 8 \
            "$LAUNCH_LEASE_IDENTITY" >/dev/null; then
      die 'launch lease descriptor is not held by this process'
    fi
  fi
}
start_lease() {
  local slot="$1" mode="$2" lock_path="$3" identity=""
  [[ "$mode" == shared || "$mode" == exclusive ]] || die "invalid $slot lease mode"
  prepare_lease_path "$lock_path" || die "$slot lease path is unsafe"
  if [[ "$slot" == deployment ]]; then
    [[ "$DEPLOY_LEASE_ACTIVE" -eq 0 ]] || die 'deployment lease is already active'
    exec 9< "$lock_path"
    identity=$(lease_fd_operation acquire "$mode" "$lock_path" 9) \
      || { exec 9>&-; die "timed out or failed to acquire the $slot $mode lease"; }
    [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] \
      || { exec 9>&-; die "$slot lease returned an invalid identity"; }
    DEPLOY_LEASE_IDENTITY="$identity"; DEPLOY_LEASE_ACTIVE=1
  else
    [[ "$LAUNCH_LEASE_ACTIVE" -eq 0 ]] || die 'launch lease is already active'
    exec 8< "$lock_path"
    identity=$(lease_fd_operation acquire "$mode" "$lock_path" 8) \
      || { exec 8>&-; die "timed out or failed to acquire the $slot $mode lease"; }
    [[ "$identity" =~ ^[0-9]+:[0-9]+$ ]] \
      || { exec 8>&-; die "$slot lease returned an invalid identity"; }
    LAUNCH_LEASE_IDENTITY="$identity"; LAUNCH_LEASE_ACTIVE=1
  fi
  assert_lease "$slot"
}
release_lease() {
  local slot="$1" status=0
  if [[ "$slot" == deployment ]]; then
    [[ "$DEPLOY_LEASE_ACTIVE" -eq 1 ]] || return 0
    lease_fd_operation assert shared "$INSTALL_HOME/bin/.kist-deployment.lock" 9 \
      "$DEPLOY_LEASE_IDENTITY" >/dev/null || status=1
    exec 9>&-
    DEPLOY_LEASE_ACTIVE=0; DEPLOY_LEASE_IDENTITY=""
  else
    [[ "$LAUNCH_LEASE_ACTIVE" -eq 1 ]] || return 0
    lease_fd_operation assert exclusive "$RUN_DIR/dashboard-$PORT.launch.lock" 8 \
      "$LAUNCH_LEASE_IDENTITY" >/dev/null || status=1
    exec 8>&-
    LAUNCH_LEASE_ACTIVE=0; LAUNCH_LEASE_IDENTITY=""
  fi
  return "$status"
}
# shellcheck disable=SC2329 # Invoked by EXIT/INT/TERM traps below.
release_all_leases() {
  local status=0
  release_lease launch || status=1
  release_lease deployment || status=1
  return "$status"
}
trap release_all_leases EXIT

if [[ "$EVALUATE" -eq 0 ]]; then
  start_lease deployment shared "$INSTALL_HOME/bin/.kist-deployment.lock"
fi

[[ -n "$PROJECT_ROOT" ]] || PROJECT_ROOT="$PWD"
[[ -d "$PROJECT_ROOT" ]] || die "dashboard project root is not a directory: $PROJECT_ROOT"
PROJECT_ROOT="$(cd -P -- "$PROJECT_ROOT" && pwd)"

# Same schema/digest semantics as Swift and kist-rebuild. The helper reads through O_NOFOLLOW
# descriptors, rejects ACL/mode/owner/type drift, and binds executable Python plus served assets.
PROVENANCE_OUTPUT="$(python_clean - "$INSTALL_HOME" "$EVALUATE" "$EVAL_BINARY" "$EVAL_WRAPPER" \
  "$EVAL_DASHBOARD" "$EVAL_REBUILD" "$EVAL_SAFE_REBUILD" "$EVAL_CLOSURE_VERSION" \
  "$REQUIRE_ENTERPRISE" <<'PY'
import ctypes, errno, hashlib, json, os, stat, subprocess, sys
HOME=os.path.realpath(sys.argv[1]); EVALUATE=sys.argv[2]=="1"
OVERRIDES={"bin/kist-current":sys.argv[3],"bin/kist":sys.argv[4],
           "bin/kist-dashboard":sys.argv[5],"bin/kist-rebuild":sys.argv[6],
           "bin/kist-safe-rebuild.sh":sys.argv[7]}
EVAL_CLOSURE_VERSION=sys.argv[8]; REQUIRE_ENTERPRISE=sys.argv[9]=="1"
UID=os.geteuid(); MAX_FILE=512*1024*1024
MAX_TOTAL=1024*1024*1024; MAX_PATHS=4*1024*1024; MAX_ENTRIES=25000
SKIP={".git",".pytest_cache"}
IMPORTABLE=(".py",".pyw",".pyi",".pth",".so",".dylib",".bundle",".pyd",".zip",".egg",".whl",".pyz")
EXECUTABLE_SUFFIXES=(".sh",".bash",".zsh",".swift",".js",".mjs",".cjs",".pl",".rb")
CONFIG_SUFFIXES=(".toml",".yaml",".yml",".ini",".cfg",".plist")
CONFIG_NAMES={"Pipfile","requirements.txt","constraints.txt"}
def fp(s): return (s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_size,s.st_nlink,s.st_mtime_ns,s.st_ctime_ns)
libc=ctypes.CDLL(None,use_errno=True); libc.acl_get_fd_np.argtypes=[ctypes.c_int,ctypes.c_int]; libc.acl_get_fd_np.restype=ctypes.c_void_p; libc.acl_free.argtypes=[ctypes.c_void_p]
def acl(fd):
    ctypes.set_errno(0); value=libc.acl_get_fd_np(fd,256)
    if value: libc.acl_free(value); return True
    error=ctypes.get_errno()
    if error in {errno.ENOENT,errno.EINVAL,errno.ENOTSUP}: return False
    raise OSError(error,os.strerror(error))
def pins(relative):
    target=os.path.join(HOME,relative) if relative else HOME
    hc=[x for x in HOME.split("/") if x]; tc=[x for x in target.split("/") if x]
    if tc[:len(hc)]!=hc: raise RuntimeError("escape")
    out=[]; fd=os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); out.append((fd,None,fp(os.fstat(fd))))
    cur=""
    try:
        for name in tc:
            st=os.stat(name,dir_fd=fd,follow_symlinks=False); cur += "/"+name
            if not stat.S_ISDIR(st.st_mode) or st.st_mode&0o022: raise RuntimeError("directory mode")
            below=cur==HOME or cur.startswith(HOME+"/")
            if (below and st.st_uid!=UID) or (not below and st.st_uid not in {0,UID}): raise RuntimeError("directory owner")
            child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
            if fp(os.fstat(child))!=fp(st) or (below and cur!=HOME and acl(child)): os.close(child); raise RuntimeError("directory race/acl")
            out.append((child,name,fp(st))); fd=child
        return out
    except Exception:
        for item in reversed(out): os.close(item[0])
        raise
def stable(ps):
    for i,(fd,name,identity) in enumerate(ps):
        if fp(os.fstat(fd))!=identity: return False
        if i and fp(os.stat(name,dir_fd=ps[i-1][0],follow_symlinks=False))!=identity: return False
    return True
budget=[0,0]
def reserve(logical,size):
    path=logical.encode()
    if size>MAX_TOTAL-budget[0] or len(path)>MAX_PATHS-budget[1]: raise RuntimeError("aggregate bound")
    budget[0]+=size; budget[1]+=len(path)
def read_leaf(relative, executable=False, limit=MAX_FILE, logical=None, digest_only=False):
    parts=relative.split("/"); ps=pins("/".join(parts[:-1])); parent=ps[-1][0]; leaf=parts[-1]
    try:
        st=os.stat(leaf,dir_fd=parent,follow_symlinks=False); ident=fp(st)
        if (not stat.S_ISREG(st.st_mode) or st.st_uid!=UID or st.st_nlink!=1
                or st.st_mode&0o022 or st.st_size>limit): raise RuntimeError("leaf trust")
        if executable and not st.st_mode&stat.S_IXUSR: raise RuntimeError("owner execute")
        if logical is not None: reserve(logical,st.st_size)
        fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=parent)
        try:
            if fp(os.fstat(fd))!=ident or acl(fd): raise RuntimeError("leaf race/acl")
            chunks=[]; digest=hashlib.sha256() if digest_only else None; total=0
            while True:
                block=os.read(fd,min(1024*1024,limit-total+1))
                if not block: break
                total+=len(block)
                if total>limit: raise RuntimeError("leaf too large")
                if digest is not None: digest.update(block)
                else: chunks.append(block)
            if fp(os.fstat(fd))!=ident or fp(os.stat(leaf,dir_fd=parent,follow_symlinks=False))!=ident or not stable(ps): raise RuntimeError("leaf changed")
            return (digest.digest() if digest is not None else b"".join(chunks)),stat.S_IMODE(st.st_mode),st.st_size
        finally: os.close(fd)
    finally:
        for item in reversed(ps): os.close(item[0])
def cortex():
    ps=pins(".kist/cortex"); rootfd=ps[-1][0]; result=[]; visited=0
    def walk(fd,prefix):
        nonlocal visited
        initial=fp(os.fstat(fd)); observed=[]
        with os.scandir(os.dup(fd)) as scan:
            names=sorted((e.name for e in scan),key=lambda x:x.encode())
        for name in names:
            rel=f"{prefix}/{name}" if prefix else name; visited+=1
            if visited>250000 or len(rel.encode())>16384: raise RuntimeError("inventory bound")
            st=os.stat(name,dir_fd=fd,follow_symlinks=False); ident=fp(st); observed.append((name,ident))
            if name=="__pycache__" or rel.lower().endswith((".pyc",".pyo")): raise RuntimeError("unbound bytecode")
            if name in SKIP:
                if not stat.S_ISDIR(st.st_mode): raise RuntimeError("cache type")
                continue
            if stat.S_ISDIR(st.st_mode):
                if st.st_uid!=UID or st.st_mode&0o022: raise RuntimeError("cortex directory trust")
                child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
                try:
                    if fp(os.fstat(child))!=ident or acl(child): raise RuntimeError("cortex directory race/acl")
                    walk(child,rel)
                    if fp(os.fstat(child))!=ident or fp(os.stat(name,dir_fd=fd,follow_symlinks=False))!=ident: raise RuntimeError("cortex directory changed")
                finally: os.close(child)
            elif stat.S_ISREG(st.st_mode):
                lower=rel.lower(); executable=bool(st.st_mode&(stat.S_IXUSR|stat.S_IXGRP|stat.S_IXOTH))
                selected=(lower.endswith(IMPORTABLE) or rel.startswith("live/assets/")
                          or name in CONFIG_NAMES or lower.endswith(CONFIG_SUFFIXES))
                if executable and not selected:
                    if not lower.endswith(EXECUTABLE_SUFFIXES): raise RuntimeError("unrecognized executable cortex payload")
                    selected=True
                if not selected: continue
                if (len(result)>=MAX_ENTRIES-5 or st.st_uid!=UID or st.st_nlink!=1
                        or st.st_mode&0o022 or st.st_size>MAX_FILE): raise RuntimeError("cortex leaf trust")
                logical=f".kist/cortex/{rel}"; reserve(logical,st.st_size)
                child=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=fd)
                try:
                    if fp(os.fstat(child))!=ident or acl(child): raise RuntimeError("cortex leaf race/acl")
                    digest=hashlib.sha256(); remaining=st.st_size
                    while remaining:
                        block=os.read(child,min(1024*1024,remaining))
                        if not block: raise RuntimeError("cortex leaf short read")
                        digest.update(block); remaining-=len(block)
                    if os.read(child,1) or fp(os.fstat(child))!=ident or fp(os.stat(name,dir_fd=fd,follow_symlinks=False))!=ident: raise RuntimeError("cortex leaf changed")
                    result.append((logical,digest.digest(),stat.S_IMODE(st.st_mode),st.st_size))
                finally: os.close(child)
            else: raise RuntimeError("cortex special/symlink")
        if fp(os.fstat(fd))!=initial: raise RuntimeError("cortex inventory changed")
        for name,ident in observed:
            if fp(os.stat(name,dir_fd=fd,follow_symlinks=False))!=ident: raise RuntimeError("cortex name changed")
    try:
        walk(rootfd,"")
        if not stable(ps): raise RuntimeError("cortex ancestry changed")
        return result
    finally:
        for item in reversed(ps): os.close(item[0])
schema3_required={"schema","stamp","deployed","worktree","branch","commit","remote-origin-sha256","repository-id","source-dirty","source-state-sha256","binary-sha256","wrapper-sha256","dashboard-launcher-sha256","rebuild-sha256","dashboard-runtime-sha256","artifact-closure-sha256","artifact-closure-count","test-evidence"}
