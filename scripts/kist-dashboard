# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap below.
cleanup_dashboard() {
  if [[ -n "$SERVER_PID" ]] && /bin/kill -0 "$SERVER_PID" 2>/dev/null; then
    /bin/kill -TERM "$SERVER_PID" 2>/dev/null || true
  fi
  [[ -z "$BOOT_RECEIPT" ]] || /bin/rm -f "$BOOT_RECEIPT"
  release_all_leases
}
