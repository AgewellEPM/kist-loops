    if computed.get(key)!=fields[key]: raise SystemExit(1)
print(root)
PY
}

validate_installed_dashboard() {
  python_clean - "$DASHBOARD_LAUNCHER" "$DASHBOARD_REBUILD" "$DASHBOARD_RUNTIME" <<'PY'
import ctypes,errno,os,pwd
import stat
import sys

uid = os.geteuid()
account_home=os.path.realpath(pwd.getpwuid(uid).pw_dir)
libc=ctypes.CDLL(None,use_errno=True);libc.acl_get_fd_np.restype=ctypes.c_void_p;libc.acl_free.argtypes=[ctypes.c_void_p]
def has_acl(path):
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        ctypes.set_errno(0); value=libc.acl_get_fd_np(fd,256)
        if value: libc.acl_free(value); return True
        if ctypes.get_errno() in {errno.ENOENT,errno.EINVAL,errno.ENOTSUP}: return False
        raise SystemExit(1)
    finally: os.close(fd)
for index, path in enumerate(sys.argv[1:]):
    if not os.path.isabs(path):
        raise SystemExit(1)
    current = "/"
    parts = [part for part in path.split("/") if part]
    paths = [current]
    for part in parts:
        current = os.path.join(current, part)
        paths.append(current)
    for offset, item in enumerate(paths):
        info = os.lstat(item)
        leaf = offset == len(paths) - 1
        if (leaf and (not stat.S_ISREG(info.st_mode) or info.st_nlink!=1)) or (not leaf and not stat.S_ISDIR(info.st_mode)):
            raise SystemExit(1)
        if info.st_uid not in {0, uid} or info.st_mode & 0o022:
            raise SystemExit(1)
        if item != account_home:
            if has_acl(item): raise SystemExit(1)
        if leaf and info.st_uid != uid:
            raise SystemExit(1)
        if leaf and not info.st_mode & stat.S_IXUSR:
            raise SystemExit(1)
PY
}

# Validate schema-4 retained evidence and actual signing while the caller already holds the
# exclusive deployment lease. Calling `kist-dashboard --provenance-validate` here would attempt a
# nested shared flock and self-deadlock. `deployed_repo` remains the closure/Git/manifest validator;
# this function supplies the dashboard validator's pilot/enterprise evidence and signing checks.
validate_installed_provenance_exclusive() {
  deployed_repo >/dev/null || return 1
  validate_installed_dashboard || return 1
  provenance_projection=$(python_clean - "$INSTALL_HOME/bin/kist-current.manifest" \
    "$INSTALL_HOME/bin/kist-current.provenance.json" <<'PY'
import hashlib,json,os,stat,sys
manifest_path,evidence_path=sys.argv[1:]; uid=os.geteuid()
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def stable(path,limit):
    before=os.lstat(path); identity=fp(before)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=uid or before.st_nlink!=1
            or stat.S_IMODE(before.st_mode)!=0o600 or before.st_size>limit):
        raise SystemExit(1)
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        if fp(os.fstat(fd))!=identity: raise SystemExit(1)
        chunks=[]; remaining=before.st_size
        while remaining:
            block=os.read(fd,min(1024*1024,remaining))
            if not block: raise SystemExit(1)
            chunks.append(block); remaining-=len(block)
        if os.read(fd,1) or fp(os.fstat(fd))!=identity or fp(os.lstat(path))!=identity:
            raise SystemExit(1)
        return b"".join(chunks)
    finally: os.close(fd)
manifest_raw=stable(manifest_path,262144); evidence=stable(evidence_path,64*1024*1024)
try: text=manifest_raw.decode("utf-8")
except UnicodeDecodeError: raise SystemExit(1)
if not text.endswith("\n") or "\r" in text: raise SystemExit(1)
fields={}
for line in text.splitlines():
    if not line or ":" not in line: raise SystemExit(1)
    key,value=line.split(":",1); key=key.strip().lower(); value=value.strip()
    if not key or not value or key in fields: raise SystemExit(1)
    fields[key]=value
if fields.get("schema")!="4" or fields.get("deployment-assurance") not in {"pilot","enterprise"}:
    raise SystemExit(1)
if hashlib.sha256(evidence).hexdigest()!=fields.get("deployment-evidence-sha256"):
    raise SystemExit(1)
if fields["deployment-assurance"]=="pilot":
    try: pilot=json.loads(evidence)
    except (UnicodeDecodeError,json.JSONDecodeError): raise SystemExit(1)
    expected={"schema":1,"assurance":"pilot","provenance_kind":"local-candidate",
              "product_version":fields.get("product-version"),
              "source_state_sha256":fields.get("source-state-sha256"),
              "unsigned_release_sha256":fields.get("unsigned-release-sha256"),
              "signed_installed_sha256":fields.get("signed-installed-sha256")}
    if type(pilot) is not dict or pilot!=expected or (
            json.dumps(pilot,sort_keys=True,separators=(",",":"),ensure_ascii=True)+"\n").encode()!=evidence:
        raise SystemExit(1)
elif fields.get("enterprise-evidence-sha256")!=fields.get("deployment-evidence-sha256"):
    raise SystemExit(1)
for key in ["deployment-assurance","signing-type","signing-identity","notarization-status"]:
    value=fields.get(key)
    if not value or "\n" in value or "\r" in value: raise SystemExit(1)
    print(key+"="+value)
PY
  ) || return 1
  projection_value() {
    printf '%s\n' "$provenance_projection" | /usr/bin/awk -F= -v key="$1" \
      '$1==key {if(seen++)exit 2;value=substr($0,length(key)+2)} END{if(seen!=1||value=="")exit 3;print value}'
  }
  installed_assurance=$(projection_value deployment-assurance) || return 1
  expected_signing_type=$(projection_value signing-type) || return 1
  expected_signing_identity=$(projection_value signing-identity) || return 1
  expected_notarization=$(projection_value notarization-status) || return 1
  if [ "$installed_assurance" = enterprise ]; then
    enterprise_evidence_evaluate "$INSTALL_HOME/bin/kist-current.provenance.json" \
      "$INSTALL_HOME/bin/kist-current.manifest" "$INSTALL_HOME/bin/kist-current" >/dev/null \
      || return 1
  fi
  actual_signing=$(signing_state "$INSTALL_HOME/bin/kist-current") || return 1
  actual_signing_type=$(printf '%s\n' "$actual_signing" | /usr/bin/awk -F= \
    '$1=="signing-type"{if(seen++)exit 2;value=substr($0,14)} END{if(seen!=1)exit 3;print value}') \
    || return 1
  actual_signing_identity=$(printf '%s\n' "$actual_signing" | /usr/bin/awk -F= \
    '$1=="signing-identity"{if(seen++)exit 2;value=substr($0,18)} END{if(seen!=1)exit 3;print value}') \
    || return 1
  actual_notarization=$(printf '%s\n' "$actual_signing" | /usr/bin/awk -F= \
    '$1=="notarization-status"{if(seen++)exit 2;value=substr($0,21)} END{if(seen!=1)exit 3;print value}') \
    || return 1
  [ "$actual_signing_type" = "$expected_signing_type" ] \
    && [ "$actual_signing_identity" = "$expected_signing_identity" ] \
    && [ "$actual_notarization" = "$expected_notarization" ] || return 1
  if [ "$installed_assurance" = enterprise ]; then
    [ "$actual_signing_type" = developer-id ] && [ "$actual_notarization" = accepted ] || return 1
  fi
}

# The rebuilding shell owns descriptor 9 and therefore owns the BSD flock itself.  A short,
# trusted Python process validates the path and applies flock to the inherited open-file
# description; the lock remains held by this shell after that process exits.  Candidate code and
# hooks never inherit descriptor 9.
DEPLOY_LEASE_ACTIVE=0
DEPLOY_LEASE_MODE=
DEPLOY_LEASE_IDENTITY=
DEPLOY_LEASE_PATH="$INSTALL_HOME/bin/.kist-deployment.lock"

lease_python() {
  /usr/bin/env -i HOME="$INSTALL_HOME" PATH="$SAFE_PATH" LANG=C LC_ALL=C \
    TMPDIR=/private/tmp PYTHONNOUSERSITE=1 "$PYTHON" -I "$@"
}

prepare_deployment_lease_path() {
  lease_python - "$DEPLOY_LEASE_PATH" <<'PY'
import os,stat,sys
path=sys.argv[1]; uid=os.geteuid()
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
parent=os.path.dirname(path); leaf=os.path.basename(path)
if not leaf or "/" in leaf or not path.startswith("/") or os.path.realpath(parent)!=parent:
    raise SystemExit(1)
directory=os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); pins=[]
try:
    root=os.fstat(directory)
    if not stat.S_ISDIR(root.st_mode) or root.st_uid not in {0,uid} or root.st_mode&0o022:
        raise SystemExit(1)
    for part in [item for item in parent.split("/") if item]:
        named=os.stat(part,dir_fd=directory,follow_symlinks=False)
        if (not stat.S_ISDIR(named.st_mode) or named.st_uid not in {0,uid}
                or named.st_mode&0o022):
            raise SystemExit(1)
        child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=directory)
        if fp(os.fstat(child))!=fp(named):
            os.close(child); raise SystemExit(1)
        pins.append((directory,part,child,dfp(named))); directory=child
    try:
        named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    except FileNotFoundError:
        fd=os.open(leaf,os.O_RDONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,
                   dir_fd=directory)
        os.close(fd); os.fsync(directory)
        named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    if (not stat.S_ISREG(named.st_mode) or named.st_uid!=uid or named.st_nlink!=1
            or stat.S_IMODE(named.st_mode)!=0o600):
        raise SystemExit(1)
    fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=directory)
    try:
        if fp(os.fstat(fd))!=fp(named):
            raise SystemExit(1)
    finally:
        os.close(fd)
    for parent_fd,name,child_fd,identity in pins:
        if dfp(os.fstat(child_fd))!=identity:
            raise SystemExit(1)
        if dfp(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=identity:
            raise SystemExit(1)
finally:
    descriptors={directory}
    for parent_fd,_,child_fd,_ in pins:
        descriptors.update({parent_fd,child_fd})
    for descriptor in descriptors:
        os.close(descriptor)
PY
}

deployment_lease_fd_operation() {
  lease_action=$1
  lease_mode=$2
  lease_expected=${3-}
  lease_python - "$lease_action" "$lease_mode" "$DEPLOY_LEASE_PATH" \
    "$lease_expected" <<'PY'
import fcntl,os,stat,sys,time
action,mode,path,expected=sys.argv[1:]; uid=os.geteuid(); fd=9
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
def lock_fp(value):
    return (value.st_dev,value.st_ino)
def valid_file(value):
    return (stat.S_ISREG(value.st_mode) and value.st_uid==uid and value.st_nlink==1
            and stat.S_IMODE(value.st_mode)==0o600)
parent=os.path.dirname(path); leaf=os.path.basename(path)
if action not in {"acquire","assert"} or mode not in {"shared","exclusive"}:
    raise SystemExit(1)
if not leaf or "/" in leaf or not path.startswith("/") or os.path.realpath(parent)!=parent:
    raise SystemExit(1)
inherited=os.fstat(fd)
if not valid_file(inherited):
    raise SystemExit(1)
directory=os.open("/",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); pins=[]
try:
    root=os.fstat(directory)
    if not stat.S_ISDIR(root.st_mode) or root.st_uid not in {0,uid} or root.st_mode&0o022:
        raise SystemExit(1)
    for part in [item for item in parent.split("/") if item]:
        named=os.stat(part,dir_fd=directory,follow_symlinks=False)
        if (not stat.S_ISDIR(named.st_mode) or named.st_uid not in {0,uid}
                or named.st_mode&0o022):
            raise SystemExit(1)
        child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=directory)
        if fp(os.fstat(child))!=fp(named):
            os.close(child); raise SystemExit(1)
        pins.append((directory,part,child,dfp(named))); directory=child
    named=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
    named_fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=directory)
    try:
        if not valid_file(named) or fp(os.fstat(named_fd))!=fp(named):
            raise SystemExit(1)
        if lock_fp(named)!=lock_fp(inherited) or fp(os.fstat(fd))!=fp(inherited):
            raise SystemExit(1)
        identity=f"{inherited.st_dev}:{inherited.st_ino}"
        if action=="assert":
            if identity!=expected:
                raise SystemExit(1)
        else:
            deadline=time.monotonic()+120.0
            operation=(fcntl.LOCK_SH if mode=="shared" else fcntl.LOCK_EX)|fcntl.LOCK_NB
            while True:
                try:
                    fcntl.flock(fd,operation); break
                except BlockingIOError:
                    if time.monotonic()>=deadline:
                        raise SystemExit(75)
                    time.sleep(.05)
        if fp(os.fstat(fd))!=fp(inherited):
            raise SystemExit(1)
        refreshed=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
        if fp(refreshed)!=fp(named) or lock_fp(refreshed)!=lock_fp(inherited):
            raise SystemExit(1)
        for parent_fd,name,child_fd,pinned in pins:
            if dfp(os.fstat(child_fd))!=pinned:
                raise SystemExit(1)
            if dfp(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=pinned:
                raise SystemExit(1)
        print(identity)
    finally:
        os.close(named_fd)
finally:
    descriptors={directory}
    for parent_fd,_,child_fd,_ in pins:
        descriptors.update({parent_fd,child_fd})
    for descriptor in descriptors:
        os.close(descriptor)
PY
}

deployment_lease_alive() {
  [ "$DEPLOY_LEASE_ACTIVE" -eq 1 ] \
    && deployment_lease_fd_operation assert "$DEPLOY_LEASE_MODE" \
      "$DEPLOY_LEASE_IDENTITY" >/dev/null
}
require_deployment_lease() {
  required_mode=${1-}
  [ "$DEPLOY_LEASE_ACTIVE" -eq 1 ] || die "deployment lease is not active"
  [ -z "$required_mode" ] || [ "$DEPLOY_LEASE_MODE" = "$required_mode" ] \
    || die "deployment $required_mode lease is not active"
  deployment_lease_alive || die "deployment lease descriptor is not held by this process"
}
acquire_deployment_lease() {
  lease_mode=$1
  [ "$DEPLOY_LEASE_ACTIVE" -eq 0 ] || die "deployment lease is already active"
  case "$lease_mode" in shared|exclusive) ;; *) die "invalid deployment lease mode" ;; esac
  prepare_deployment_lease_path || die "deployment lease path is unsafe"
  if ! exec 9< "$DEPLOY_LEASE_PATH"; then
    die "cannot open deployment lease"
  fi
  if ! lease_identity=$(deployment_lease_fd_operation acquire "$lease_mode"); then
    exec 9>&-
    die "timed out or failed to acquire the deployment $lease_mode lease"
  fi
  case "$lease_identity" in
    ""|*[!0-9:]*|:*|*:|*:*:*)
      exec 9>&-; die "deployment lease returned an invalid identity" ;;
    *:*) ;;
    *) exec 9>&-; die "deployment lease returned an invalid identity" ;;
  esac
  DEPLOY_LEASE_ACTIVE=1
  DEPLOY_LEASE_MODE=$lease_mode
  DEPLOY_LEASE_IDENTITY=$lease_identity
  deployment_lease_alive || {
    exec 9>&-
    DEPLOY_LEASE_ACTIVE=0
    DEPLOY_LEASE_MODE=
    DEPLOY_LEASE_IDENTITY=
    die "deployment lease descriptor was lost during acquisition"
  }
}
abandon_deployment_lease() {
  [ "$DEPLOY_LEASE_ACTIVE" -eq 1 ] || return 0
  exec 9>&-
  DEPLOY_LEASE_ACTIVE=0
  DEPLOY_LEASE_MODE=
  DEPLOY_LEASE_IDENTITY=
}
ensure_exclusive_recovery_lease() {
  if [ "$DEPLOY_LEASE_ACTIVE" -eq 1 ] && [ "$DEPLOY_LEASE_MODE" = exclusive ] \
     && deployment_lease_alive; then
    return 0
  fi
  abandon_deployment_lease
  acquire_deployment_lease exclusive
  deployment_lease_alive
}
release_deployment_lease() {
  [ "$DEPLOY_LEASE_ACTIVE" -eq 1 ] || return 0
  lease_release_status=0
  deployment_lease_alive || lease_release_status=1
  exec 9>&-
  DEPLOY_LEASE_ACTIVE=0
  DEPLOY_LEASE_MODE=
  DEPLOY_LEASE_IDENTITY=
  return "$lease_release_status"
}

TRANSACTION_ACTIVE=0
transaction_control() {
  transaction_action=$1
  shift
  case "$transaction_action" in
    check-clean) require_deployment_lease ;;
    recover|begin|begin-finalize|rollback|commit) require_deployment_lease exclusive ;;
    *) die "unknown deployment transaction action" ;;
  esac
  python_clean - "$INSTALL_HOME" "$SNAPSHOT_PARENT" "$transaction_action" "$@" <<'PY'
import ctypes,errno,hashlib,json,os,re,secrets,stat,sys
home,snapshot_parent,action,*stages=sys.argv[1:]
uid=os.geteuid(); home=os.path.realpath(home); bindir=os.path.join(home,"bin")
journal=os.path.join(bindir,".kist-rebuild-journal")
legacy_targets=["kist-current","kist","kist-dashboard","kist-rebuild","kist-current.manifest",".kist-build"]
legacy_full_targets=legacy_targets+["kist-current.provenance.json"]
full_targets=["kist-current","kist","kist-dashboard","kist-rebuild","kist-safe-rebuild.sh",
              "kist-current.manifest",".kist-build","kist-current.provenance.json"]
finalize_targets=["kist-current.manifest","kist-current.provenance.json"]
executable_targets={"kist-current","kist","kist-dashboard","kist-rebuild","kist-safe-rebuild.sh"}
def fp(value): return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
bst=os.lstat(bindir)
if not stat.S_ISDIR(bst.st_mode) or bst.st_uid!=uid or bst.st_mode&0o022 or os.path.realpath(bindir)!=bindir: raise SystemExit(1)
bfd=os.open(bindir,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
if fp(os.fstat(bfd))!=fp(bst): raise SystemExit(1)
def fsync_dir(): os.fsync(bfd)
def secure_regular(path, executable=None):
    value=os.lstat(path)
    if not stat.S_ISREG(value.st_mode) or value.st_uid!=uid or value.st_nlink!=1 or value.st_mode&0o022: raise SystemExit(1)
    if executable is True and not value.st_mode&stat.S_IXUSR: raise SystemExit(1)
    if executable is False and stat.S_IMODE(value.st_mode)!=0o600: raise SystemExit(1)
    return value
def write_all(fd,data):
    offset=0
    while offset<len(data):
        written=os.write(fd,data[offset:])
        if written<=0: raise SystemExit(1)
        offset+=written
def atomic_json(payload):
    raw=(json.dumps(payload,sort_keys=True,separators=(",",":"))+"\n").encode()
    temp=f".kist-rebuild-journal.{secrets.token_hex(16)}"
    fd=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=bfd)
    try: write_all(fd,raw); os.fsync(fd)
    finally: os.close(fd)
    os.replace(temp,os.path.basename(journal),src_dir_fd=bfd,dst_dir_fd=bfd); fsync_dir()
def read_journal():
    st=secure_regular(journal,False)
    if st.st_size>65536: raise SystemExit(1)
    fd=os.open(os.path.basename(journal),os.O_RDONLY|os.O_NOFOLLOW,dir_fd=bfd)
    try:
        if fp(os.fstat(fd))!=fp(st): raise SystemExit(1)
        chunks=[]; remaining=st.st_size
        while remaining:
            block=os.read(fd,min(65536,remaining))
            if not block: raise SystemExit(1)
            chunks.append(block); remaining-=len(block)
        if os.read(fd,1) or fp(os.fstat(fd))!=fp(st): raise SystemExit(1)
    finally: os.close(fd)
    raw=b"".join(chunks)
    if not raw.endswith(b"\n") or b"\n" in raw[:-1] or b"\r" in raw: raise SystemExit(1)
    value=json.loads(raw)
    required={"schema","token","phase","backup","targets","present","installed"}
    if type(value) is not dict or set(value)!=required or type(value["schema"]) is not int or value["schema"]!=1: raise SystemExit(1)
    if type(value["token"]) is not str or len(value["token"])!=32 or any(c not in "0123456789abcdef" for c in value["token"]): raise SystemExit(1)
    if type(value["phase"]) is not str or value["phase"] not in {"preparing","prepared","activating","active","rolling-back","rolled-back","committed"}: raise SystemExit(1)
    targets=value["targets"]
    if (targets!=legacy_targets and targets!=legacy_full_targets
            and targets!=full_targets and targets!=finalize_targets): raise SystemExit(1)
    if type(value["present"]) is not dict or set(value["present"])!=set(targets): raise SystemExit(1)
    if any(type(value["present"][name]) is not bool for name in targets): raise SystemExit(1)
    if type(value["installed"]) is not list or any(type(name) is not str for name in value["installed"]): raise SystemExit(1)
    if len(set(value["installed"]))!=len(value["installed"]) or any(name not in targets for name in value["installed"]): raise SystemExit(1)
    expected=f".kist-rebuild-backup.{value['token']}"
    if value["backup"]!=expected: raise SystemExit(1)
    return value
def copy_stable(source,destination,mode=None):
    before=secure_regular(source)
    src=os.open(source,os.O_RDONLY|os.O_NOFOLLOW)
    temp=destination+f".new.{secrets.token_hex(12)}"
    dst=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,stat.S_IMODE(before.st_mode))
    digest=hashlib.sha256(); total=0
    promoted=False
    try:
        try:
            while True:
                block=os.read(src,1024*1024)
                if not block: break
                write_all(dst,block); digest.update(block); total+=len(block)
            if total!=before.st_size or fp(os.fstat(src))!=fp(before): raise SystemExit(1)
            os.fchmod(dst,stat.S_IMODE(before.st_mode) if mode is None else mode); os.fsync(dst)
        finally:
            os.close(src); os.close(dst)
        os.replace(temp,destination); promoted=True
    finally:
        if not promoted:
            try: os.unlink(temp)
            except FileNotFoundError: pass
    return digest.hexdigest()
def remove_backup(value):
    backup=os.path.join(bindir,value["backup"])
    try:
        backup_st=os.lstat(backup)
        if (not stat.S_ISDIR(backup_st.st_mode) or backup_st.st_uid!=uid
                or stat.S_IMODE(backup_st.st_mode)!=0o700
                or os.path.realpath(backup)!=backup):
            raise SystemExit(1)
        names=os.listdir(backup)
    except FileNotFoundError: names=[]
    generated=re.compile(
        r"(?:"+"|".join(re.escape(name) for name in value["targets"])+r")\.new\.[0-9a-f]{24}")
    if any(name not in value["targets"] and not generated.fullmatch(name) for name in names):
        raise SystemExit(1)
    for name in names:
        path=os.path.join(backup,name); secure_regular(path); os.unlink(path)
    try: os.rmdir(backup)
    except FileNotFoundError: pass
def rollback(value):
    for name in os.listdir(bindir):
        if any(re.fullmatch(re.escape(target)+r"\.new\.[0-9a-f]{24}",name)
               for target in value["targets"]):
            secure_regular(os.path.join(bindir,name)); os.unlink(name,dir_fd=bfd)
    value["phase"]="rolling-back"; atomic_json(value)
    backup=os.path.join(bindir,value["backup"])
    for name in value["targets"]:
        target=os.path.join(bindir,name); saved=os.path.join(backup,name)
        if value["present"][name]:
            secure_regular(saved)
            copy_stable(saved,target)
        else:
            try:
                current=os.lstat(target)
                if not stat.S_ISREG(current.st_mode) or current.st_uid!=uid: raise SystemExit(1)
                os.unlink(target)
            except FileNotFoundError: pass
    fsync_dir()
    value["phase"]="rolled-back"; atomic_json(value)
    remove_backup(value); os.unlink(journal); fsync_dir()
def finish_without_restore(value):
    remove_backup(value)
    os.unlink(journal)
    fsync_dir()
def recover_journal(value):
    if value["phase"] in {"preparing","rolled-back","committed"}:
        finish_without_restore(value)
    else:
        rollback(value)
def cleanup_orphans():
    removed=False
    generated_target=re.compile(
        r"(?:"+"|".join(re.escape(name) for name in full_targets)+r")\.new\.[0-9a-f]{24}")
    reserved_prefixes=[
        ".kist-current.new",".kist.wrapper",".kist-dashboard",".kist-rebuild",
        ".kist-safe-rebuild",".kist-current.manifest",".kist-build",
        ".kist-current.provenance",".kist-status",".kist-notary-archive",
        ".kist-notary-result",".kist-current.manifest.final",
        ".kist-current.provenance.final",".kist-current.projection.final",
    ]
    reserved_temp=re.compile(
        r"(?:"+"|".join(re.escape(name) for name in reserved_prefixes)+r")\.[A-Za-z0-9]{6}")
    for name in os.listdir(bindir):
        path=os.path.join(bindir,name)
        if re.fullmatch(r"\.kist-rebuild-journal\.[0-9a-f]{32}",name):
            secure_regular(path); os.unlink(name,dir_fd=bfd); removed=True
        elif re.fullmatch(r"\.kist-rebuild-backup\.[0-9a-f]{32}",name):
            remove_backup({"backup":name,"targets":full_targets}); removed=True
        elif generated_target.fullmatch(name):
            secure_regular(path); os.unlink(name,dir_fd=bfd); removed=True
        elif reserved_temp.fullmatch(name):
            secure_regular(path); os.unlink(name,dir_fd=bfd); removed=True
    if removed: fsync_dir()
def cleanup_stale_snapshots():
    expected=os.path.join(home,".kist-rebuild-private-tmp")
    if snapshot_parent!=expected or os.path.realpath(snapshot_parent)!=snapshot_parent:
        raise SystemExit(1)
    try: parent_st=os.lstat(snapshot_parent)
    except FileNotFoundError:
        os.mkdir(snapshot_parent,0o700)
        os.chmod(snapshot_parent,0o700)
        parent_st=os.lstat(snapshot_parent)
    if (not stat.S_ISDIR(parent_st.st_mode) or parent_st.st_uid!=uid
            or stat.S_IMODE(parent_st.st_mode)!=0o700):
        raise SystemExit(1)
    parent_fd=os.open(snapshot_parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    libc=ctypes.CDLL(None,use_errno=True)
    libc.acl_get_fd_np.argtypes=[ctypes.c_int,ctypes.c_int]
    libc.acl_get_fd_np.restype=ctypes.c_void_p
    libc.acl_free.argtypes=[ctypes.c_void_p]
    def has_acl(fd):
        ctypes.set_errno(0); value=libc.acl_get_fd_np(fd,256)
        if value:
            libc.acl_free(value); return True
        if ctypes.get_errno() in {errno.ENOENT,errno.EINVAL,errno.ENOTSUP}: return False
        raise SystemExit(1)
    def directory_identity(value):
        return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
    def same_directory(left,right):
        return (stat.S_ISDIR(left.st_mode) and stat.S_ISDIR(right.st_mode)
                and (left.st_dev,left.st_ino,left.st_uid)==(right.st_dev,right.st_ino,right.st_uid))
    def remove_tree(parent,name,root=False,root_dev=None):
        named=os.stat(name,dir_fd=parent,follow_symlinks=False); identity=directory_identity(named)
        if not stat.S_ISDIR(named.st_mode) or named.st_uid!=uid:
            raise SystemExit(1)
        if root and stat.S_IMODE(named.st_mode)!=0o700:
            raise SystemExit(1)
        if root_dev is None: root_dev=named.st_dev
        if named.st_dev!=root_dev: raise SystemExit(1)
        directory=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent)
        try:
            opened=os.fstat(directory)
            rebound=os.stat(name,dir_fd=parent,follow_symlinks=False)
            if (directory_identity(opened)!=identity or directory_identity(rebound)!=identity
                    or (root and has_acl(directory))):
                raise SystemExit(1)
            # A killed build can leave source-mode 0555/0550 descendants.  After proving the opened
            # inode is still bound to this private snapshot name, make only that inode owner-writable
            # and carry its new descriptor/name identity through recursive removal.
            os.fchmod(directory,0o700)
            writable=os.fstat(directory)
            rebound=os.stat(name,dir_fd=parent,follow_symlinks=False)
            writable_identity=directory_identity(writable)
            if (not same_directory(writable,named)
                    or directory_identity(rebound)!=writable_identity
                    or stat.S_IMODE(writable.st_mode)!=0o700):
                raise SystemExit(1)
            with os.scandir(os.dup(directory)) as scan:
                names=sorted((entry.name for entry in scan),key=lambda value:value.encode())
            for child_name in names:
                child=os.stat(child_name,dir_fd=directory,follow_symlinks=False)
                if child.st_uid!=uid or child.st_dev!=root_dev:
                    raise SystemExit(1)
                if stat.S_ISDIR(child.st_mode):
                    remove_tree(directory,child_name,root_dev=root_dev)
                elif (stat.S_ISREG(child.st_mode) or stat.S_ISLNK(child.st_mode)
                      or stat.S_ISFIFO(child.st_mode) or stat.S_ISSOCK(child.st_mode)):
                    if not stat.S_ISLNK(child.st_mode) and child.st_nlink!=1:
                        raise SystemExit(1)
                    os.unlink(child_name,dir_fd=directory)
                else:
                    raise SystemExit(1)
            if directory_identity(os.fstat(directory))!=writable_identity:
                raise SystemExit(1)
            if directory_identity(os.stat(name,dir_fd=parent,follow_symlinks=False))!=writable_identity:
                raise SystemExit(1)
        finally:
            os.close(directory)
        os.rmdir(name,dir_fd=parent)
    try:
        if fp(os.fstat(parent_fd))!=fp(parent_st) or has_acl(parent_fd):
            raise SystemExit(1)
        snapshot_name=re.compile(r"kist-source-snapshot\.[A-Za-z0-9]{6}")
        suite_name=re.compile(r"kist-rebuild-suite\.[A-Za-z0-9]{6}")
        changed=False
        for name in os.listdir(snapshot_parent):
            if snapshot_name.fullmatch(name):
                path=os.path.join(snapshot_parent,name)
                if os.path.realpath(path)!=path: raise SystemExit(1)
                remove_tree(parent_fd,name,root=True); changed=True
            elif suite_name.fullmatch(name):
                value=os.stat(name,dir_fd=parent_fd,follow_symlinks=False)
                if (not stat.S_ISREG(value.st_mode) or value.st_uid!=uid or value.st_nlink!=1
                        or value.st_mode&0o022):
                    raise SystemExit(1)
                os.unlink(name,dir_fd=parent_fd); changed=True
        if changed: os.fsync(parent_fd)
    finally:
        os.close(parent_fd)
try:
    if action=="check-clean":
        if os.path.lexists(journal): raise SystemExit(1)
    elif action=="recover":
        if os.path.lexists(journal):
            value=read_journal()
            recover_journal(value)
        cleanup_orphans()
        cleanup_stale_snapshots()
        # A kill between archive validation and transaction begin can leave only these fixed-format,
        # owner-private stage files. The exclusive lease proves no live rollback can still own them.
        removed=False
        for name in os.listdir(bindir):
            if re.fullmatch(r"\.kist-rollback-stage\.[0-9a-f]{32}",name):
                secure_regular(os.path.join(bindir,name)); os.unlink(name,dir_fd=bfd); removed=True
        if removed: fsync_dir()
    elif action in {"begin","begin-finalize"}:
        if action=="begin":
            if len(stages)==len(full_targets): targets=full_targets
            elif len(stages)==len(legacy_full_targets): targets=legacy_full_targets
            else: raise SystemExit(1)
        else:
            targets=finalize_targets
        if len(stages)!=len(targets) or os.path.lexists(journal): raise SystemExit(1)
        for index,path in enumerate(stages):
            if not os.path.isabs(path) or os.path.dirname(path)!=bindir: raise SystemExit(1)
            secure_regular(path,(targets[index] in executable_targets) if action=="begin" else False)
        token=secrets.token_hex(16); backup_name=f".kist-rebuild-backup.{token}"; backup=os.path.join(bindir,backup_name)
        os.mkdir(backup,0o700); present={}
        for name in targets:
            path=os.path.join(bindir,name)
            try:
                secure_regular(path); present[name]=True
            except FileNotFoundError: present[name]=False
        value={"schema":1,"token":token,"phase":"preparing","backup":backup_name,
               "targets":targets,"present":present,"installed":[]}
        atomic_json(value)
        for name in targets:
            if present[name]: copy_stable(os.path.join(bindir,name),os.path.join(backup,name))
        bkupfd=os.open(backup,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); os.fsync(bkupfd); os.close(bkupfd)
        value["phase"]="prepared"; atomic_json(value)
        for name,stage in zip(targets,stages):
            os.replace(stage,os.path.join(bindir,name)); value["installed"].append(name)
            value["phase"]="activating"; atomic_json(value)
        fsync_dir(); value["phase"]="active"; atomic_json(value)
        print(token)
    elif action=="rollback":
        if os.path.lexists(journal): recover_journal(read_journal())
    elif action=="commit":
        value=read_journal()
        if value["phase"]!="active": raise SystemExit(1)
        value["phase"]="committed"; atomic_json(value)
        remove_backup(value); os.unlink(journal); fsync_dir()
    else: raise SystemExit(1)
finally: os.close(bfd)
PY
  transaction_status=$?
  [ "$transaction_status" -eq 0 ] || return "$transaction_status"
  # Commit itself is the terminal durable boundary.  Every other action remains reversible and is
  # followed by an exact helper-liveness check before its caller can continue.
  [ "$transaction_action" = commit ] || {
    case "$transaction_action" in
      check-clean) require_deployment_lease ;;
      *) require_deployment_lease exclusive ;;
    esac
  }
}

# kist-release-registry-v1
# Retain explicitly approved, exact deployment transaction sets and prepare a CAS-bound rollback.
# This registry is an owner-local recovery control, not a remote/WORM trust root: the full current
# release digest approves an archive, and the full plan digest approves a rollback.
release_registry_control() {
  registry_action=$1
  shift
  case "$registry_action" in
    status|list|plan) require_deployment_lease ;;
    archive|stage) require_deployment_lease exclusive ;;
    *) die "unknown release registry action" ;;
  esac
  python_clean - "$INSTALL_HOME" "$registry_action" "$@" <<'PY'
import datetime,hashlib,json,os,re,secrets,stat,sys,time

home,action,*arguments=sys.argv[1:]
home=os.path.realpath(home); uid=os.geteuid(); bindir=os.path.join(home,"bin")
registry=os.path.join(home,".kist","release-registry"); releases=os.path.join(registry,"releases")
legacy_targets=["kist-current","kist","kist-dashboard","kist-rebuild",
                "kist-current.manifest",".kist-build","kist-current.provenance.json"]
v3_targets=["kist-current","kist","kist-dashboard","kist-rebuild","kist-safe-rebuild.sh",
            "kist-current.manifest",".kist-build","kist-current.provenance.json"]
known_targets=set(legacy_targets)|set(v3_targets)
executables={"kist-current","kist","kist-dashboard","kist-rebuild","kist-safe-rebuild.sh"}
MAX_FILE=512*1024*1024; MAX_TOTAL=1024*1024*1024; MAX_RELEASES=32
HEX=re.compile(r"[0-9a-f]{64}")
STAGING=re.compile(r"\.release-staging\.[0-9a-f]{32}")

def fail(message):
    print("release registry: "+message,file=sys.stderr)
    raise SystemExit(1)
def canonical(value):
    return (json.dumps(value,sort_keys=True,separators=(",",":"),ensure_ascii=True)+"\n").encode()
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def write_all(fd,data):
    offset=0
    while offset<len(data):
        written=os.write(fd,data[offset:])
        if written<=0: fail("short write")
        offset+=written
def secure_directory(path,exact_private=False):
    try: value=os.lstat(path)
    except FileNotFoundError: fail("required directory is missing")
    if (not stat.S_ISDIR(value.st_mode) or value.st_uid!=uid or
            value.st_mode&0o022 or os.path.realpath(path)!=path):
        fail("directory ownership, mode, or ancestry is untrusted")
    if exact_private and stat.S_IMODE(value.st_mode)!=0o700:
        fail("registry directory is not mode 0700")
    return value
def make_private(path):
    try:
        os.mkdir(path,0o700)
        os.chmod(path,0o700)
    except FileExistsError:
        pass
    secure_directory(path,True)
def stable_read(path,limit,expected_mode=None,executable=None):
    try: before=os.lstat(path)
    except FileNotFoundError: fail("required file is missing: "+os.path.basename(path))
    mode=stat.S_IMODE(before.st_mode)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=uid or before.st_nlink!=1
            or before.st_mode&0o022 or before.st_size>limit):
        fail("file ownership, type, link count, mode, or size is untrusted: "+os.path.basename(path))
    if expected_mode is not None and mode!=expected_mode:
        fail("file mode is not canonical: "+os.path.basename(path))
    if executable is True and not before.st_mode&stat.S_IXUSR:
        fail("expected executable is not owner-executable: "+os.path.basename(path))
    if executable is False and mode!=0o600:
        fail("deployment metadata is not mode 0600: "+os.path.basename(path))
    identity=fp(before)
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        if fp(os.fstat(fd))!=identity: fail("file changed before read")
        chunks=[]; remaining=before.st_size
        while remaining:
            block=os.read(fd,min(1024*1024,remaining))
            if not block: fail("short read")
            chunks.append(block); remaining-=len(block)
        if os.read(fd,1) or fp(os.fstat(fd))!=identity or fp(os.lstat(path))!=identity:
            fail("file changed during read")
        return b"".join(chunks),mode
    finally: os.close(fd)
def parse_manifest(raw):
    try: text=raw.decode("utf-8")
    except UnicodeDecodeError: fail("manifest is not UTF-8")
    if not text.endswith("\n") or "\r" in text: fail("manifest is not canonical text")
    fields={}
    for line in text.splitlines():
        if not line or ":" not in line: fail("manifest line is malformed")
        key,value=line.split(":",1); key=key.strip().lower(); value=value.strip()
        if not key or not value or key in fields: fail("manifest field is malformed")
        fields[key]=value
    required={"schema","stamp","commit","deployment-assurance","product-version",
              "artifact-closure-sha256","source-state-sha256"}
    if not required<=set(fields) or fields["schema"]!="4":
        fail("only coherent schema-4 deployments may be archived")
    if fields["deployment-assurance"] not in {"pilot","enterprise"}:
        fail("manifest assurance is invalid")
    for key in ["commit","artifact-closure-sha256","source-state-sha256"]:
        if not HEX.fullmatch(fields[key]) and not (key=="commit" and re.fullmatch(r"[0-9a-fA-F]{40,64}",fields[key])):
            fail("manifest identity is malformed")
    return fields
def release_digest(files):
    digest=hashlib.sha256(b"kist-release-registry-v1\0")
    for item in files:
        name=item["name"].encode()
        digest.update(len(name).to_bytes(8,"big")); digest.update(name)
        digest.update(item["mode"].to_bytes(4,"big"))
        digest.update(item["bytes"].to_bytes(8,"big"))
        digest.update(bytes.fromhex(item["sha256"]))
    return digest.hexdigest()
def targets_for_names(names):
    if names==legacy_targets: return legacy_targets
    if names==v3_targets: return v3_targets
    fail("release file ordering is invalid")
def rollback_semantics(targets):
    return ("exact-v3" if targets==v3_targets
            else "best-effort-legacy-non-self-contained")
def current_inventory(include_payload=False):
    secure_directory(home); secure_directory(bindir)
    manifest_raw=stable_read(os.path.join(bindir,"kist-current.manifest"),262144,
                             executable=False)[0]
    manifest=parse_manifest(manifest_raw)
    targets=v3_targets if "safe-rebuild-sha256" in manifest else legacy_targets
    files=[]; payloads={}; total=0
    for name in targets:
        raw,mode=stable_read(os.path.join(bindir,name),MAX_FILE,
                             executable=True if name in executables else False)
        total+=len(raw)
        if total>MAX_TOTAL: fail("deployment transaction set exceeds aggregate bound")
        files.append({"bytes":len(raw),"mode":mode,"name":name,
                      "sha256":hashlib.sha256(raw).hexdigest()})
        if include_payload: payloads[name]=raw
    if include_payload and payloads["kist-current.manifest"]!=manifest_raw:
        fail("manifest changed during release inventory")
    identifier=release_digest(files)
    return identifier,files,payloads,manifest
def open_registry(create=False):
    secure_directory(home)
    kist=os.path.join(home,".kist")
    secure_directory(kist)
    if create:
        make_private(registry); make_private(releases)
    elif not os.path.lexists(registry):
        return False
    secure_directory(registry,True); secure_directory(releases,True)
    if set(os.listdir(registry))!={"releases"}: fail("registry contains unknown entries")
    return True
def release_names():
    if not open_registry(False): return []
    result=[]
    for name in os.listdir(releases):
        if STAGING.fullmatch(name):
            value=os.lstat(os.path.join(releases,name))
            if not stat.S_ISDIR(value.st_mode) or value.st_uid!=uid or stat.S_IMODE(value.st_mode)!=0o700:
                fail("archive staging entry is untrusted")
            continue
        if not re.fullmatch(r"release-[0-9a-f]{64}",name):
            fail("release registry contains an unknown entry")
        result.append(name)
    return sorted(result)
def cleanup_archive_staging():
    # Archive runs under the exclusive deployment lease. Remove only the exact private shape this
    # implementation can leave behind; an unknown name, symlink, or special file remains fail-closed.
    for name in os.listdir(releases):
        if not STAGING.fullmatch(name): continue
        directory=os.path.join(releases,name); secure_directory(directory,True)
        entries=set(os.listdir(directory))
        if not entries<= {"files","record.json"}: fail("archive staging contains unknown entries")
        record_path=os.path.join(directory,"record.json")
        if "record.json" in entries:
            value=os.lstat(record_path)
            if (not stat.S_ISREG(value.st_mode) or value.st_uid!=uid or value.st_nlink!=1
                    or value.st_mode&0o022): fail("archive staging record is untrusted")
            os.unlink(record_path)
        files_dir=os.path.join(directory,"files")
        if "files" in entries:
            secure_directory(files_dir,True)
            staged=set(os.listdir(files_dir))
            if not staged<=known_targets: fail("archive staging file set is invalid")
            for target in staged:
                value=os.lstat(os.path.join(files_dir,target))
                if (not stat.S_ISREG(value.st_mode) or value.st_uid!=uid or value.st_nlink!=1
                        or value.st_mode&0o022): fail("archive staging file is untrusted")
                os.unlink(os.path.join(files_dir,target))
            os.rmdir(files_dir)
        os.rmdir(directory)
    fsync_directory(releases)
def validate_record_shape(record,identifier):
    required={"approved_by_uid","archived_at","archived_at_unix_ns","assurance","commit",
              "files","product_version","release_id","schema","source_state_sha256","stamp"}
    if type(record) is not dict or set(record)!=required or record.get("schema")!=1:
        fail("release record schema is invalid")
    if record.get("release_id")!=identifier or record.get("approved_by_uid")!=uid:
        fail("release record identity is invalid")
    if (type(record.get("archived_at_unix_ns")) is not int or
            isinstance(record.get("archived_at_unix_ns"),bool) or record["archived_at_unix_ns"]<=0):
        fail("release archive time is invalid")
    if type(record.get("archived_at")) is not str or not record["archived_at"].endswith("Z"):
        fail("release archive timestamp is invalid")
    if record.get("assurance") not in {"pilot","enterprise"}:
        fail("release assurance is invalid")
    if type(record.get("files")) is not list:
        fail("release file inventory is invalid")
    targets=targets_for_names(
        [item.get("name") if type(item) is dict else None for item in record["files"]])
    for item in record["files"]:
        if set(item)!={"bytes","mode","name","sha256"} or type(item["bytes"]) is not int or item["bytes"]<0:
            fail("release file record is invalid")
        if (type(item["mode"]) is not int or type(item["sha256"]) is not str
                or not HEX.fullmatch(item["sha256"])):
            fail("release file record is malformed")
    if (type(record.get("commit")) is not str or not re.fullmatch(r"[0-9a-fA-F]{40,64}",record["commit"])
            or type(record.get("source_state_sha256")) is not str
            or not HEX.fullmatch(record["source_state_sha256"])
            or type(record.get("product_version")) is not str
            or type(record.get("stamp")) is not str):
        fail("release metadata is malformed")
    if release_digest(record["files"])!=identifier:
        fail("release record digest is invalid")
def validate_release(identifier,with_payload=False):
    if not HEX.fullmatch(identifier): fail("release id must be one full lowercase SHA-256 digest")
    if not open_registry(False): fail("release registry does not exist")
    directory=os.path.join(releases,"release-"+identifier); secure_directory(directory,True)
    if set(os.listdir(directory))!={"files","record.json"}: fail("release archive contains unknown entries")
    files_dir=os.path.join(directory,"files"); secure_directory(files_dir,True)
    record_raw,_=stable_read(os.path.join(directory,"record.json"),262144,expected_mode=0o600)
    try: record=json.loads(record_raw)
    except (UnicodeDecodeError,json.JSONDecodeError): fail("release record is not valid JSON")
    if canonical(record)!=record_raw: fail("release record is not canonical JSON")
    validate_record_shape(record,identifier)
    targets=targets_for_names([item["name"] for item in record["files"]])
    if set(os.listdir(files_dir))!=set(targets): fail("release archive file set is incomplete")
    total=0; payloads={}
    for item in record["files"]:
        name=item["name"]; raw,mode=stable_read(os.path.join(files_dir,name),MAX_FILE,
                                               expected_mode=item["mode"],
                                               executable=True if name in executables else False)
        total+=len(raw)
        if total>MAX_TOTAL or len(raw)!=item["bytes"] or hashlib.sha256(raw).hexdigest()!=item["sha256"]:
            fail("archived release bytes do not match their record")
        if with_payload: payloads[name]=raw
    parse_manifest(payloads["kist-current.manifest"] if with_payload else
                   stable_read(os.path.join(files_dir,"kist-current.manifest"),262144,
                               expected_mode=0o600)[0])
    return record,record_raw,payloads
def create_file(path,raw,mode):
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,mode)
    try: write_all(fd,raw); os.fchmod(fd,mode); os.fsync(fd)
    finally: os.close(fd)
def fsync_directory(path):
    fd=os.open(path,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    try: os.fsync(fd)
    finally: os.close(fd)
def atomic_output(path,payload):
    if not os.path.isabs(path) or os.path.abspath(path)!=path or os.path.lexists(path):
        fail("plan output must be a new absolute path")
    parent=os.path.dirname(path); secure_directory(parent)
    create_file(path,payload,0o600); fsync_directory(parent)
def plan_body(plan):
    return {key:plan[key] for key in
             ["created_at","created_at_unix_ns","current_release_id","schema",
              "target_record_sha256","target_release_id","target_rollback_semantics"]}
def validate_plan(path,confirm=None):
    if not os.path.isabs(path) or os.path.abspath(path)!=path: fail("plan path must be absolute")
    raw,_=stable_read(path,65536,expected_mode=0o600)
    try: plan=json.loads(raw)
    except (UnicodeDecodeError,json.JSONDecodeError): fail("rollback plan is not valid JSON")
    required={"created_at","created_at_unix_ns","current_release_id","plan_digest","schema",
              "target_record_sha256","target_release_id","target_rollback_semantics"}
    if type(plan) is not dict or set(plan)!=required or plan.get("schema")!=1 or canonical(plan)!=raw:
        fail("rollback plan is not canonical")
    for key in ["current_release_id","plan_digest","target_record_sha256","target_release_id"]:
        if type(plan.get(key)) is not str or not HEX.fullmatch(plan[key]): fail("rollback plan digest is invalid")
    if plan["target_rollback_semantics"] not in {
            "exact-v3","best-effort-legacy-non-self-contained"}:
        fail("rollback plan semantics are invalid")
    if (type(plan.get("created_at")) is not str or not plan["created_at"].endswith("Z")
            or type(plan.get("created_at_unix_ns")) is not int
            or isinstance(plan["created_at_unix_ns"],bool) or plan["created_at_unix_ns"]<=0):
        fail("rollback plan timestamp is invalid")
    expected=hashlib.sha256(b"kist-rollback-plan-v1\0"+canonical(plan_body(plan))).hexdigest()
    if plan["plan_digest"]!=expected or (confirm is not None and confirm!=expected):
        fail("rollback plan confirmation does not match")
    if plan["current_release_id"]==plan["target_release_id"]: fail("rollback target equals current release")
    return plan

if action=="status":
    if arguments: fail("status takes no values")
    identifier,files,_,manifest=current_inventory()
    archived=False
    if open_registry(False) and "release-"+identifier in release_names():
        validate_release(identifier); archived=True
    print(canonical({"archived":archived,"assurance":manifest["deployment-assurance"],
                     "commit":manifest["commit"],"current_release_id":identifier,
                     "product_version":manifest["product-version"],
                     "rollback_semantics":rollback_semantics(
                         targets_for_names([item["name"] for item in files])),
                     "schema":1}).decode(),end="")
elif action=="list":
    if arguments: fail("list takes no values")
    values=[]
    for name in release_names():
        identifier=name[8:]; record,raw,_=validate_release(identifier)
        values.append({"archived_at":record["archived_at"],"assurance":record["assurance"],
                       "commit":record["commit"],"product_version":record["product_version"],
                       "record_sha256":hashlib.sha256(raw).hexdigest(),"release_id":identifier,
                       "rollback_semantics":rollback_semantics(
                           targets_for_names([item["name"] for item in record["files"]]))})
    print(canonical({"releases":values,"schema":1}).decode(),end="")
elif action=="archive":
    if len(arguments)!=1 or not HEX.fullmatch(arguments[0]):
        fail("archive requires one full lowercase current release digest")
    confirm=arguments[0]; identifier,files,payloads,manifest=current_inventory(True)
    if confirm!=identifier: fail("archive confirmation does not match the current deployment")
    if "safe-rebuild-sha256" not in manifest:
        fail("legacy transitional deployments may be validated but not archived; complete the v3 promotion")
    open_registry(True); cleanup_archive_staging(); names=release_names()
    if "release-"+identifier in names:
        record,raw,_=validate_release(identifier)
        print(canonical({"created":False,"record_sha256":hashlib.sha256(raw).hexdigest(),
                         "release_id":identifier,"schema":1}).decode(),end="")
        raise SystemExit(0)
    if len(names)>=MAX_RELEASES: fail("release registry reached its 32-release bound")
    timestamp_ns=time.time_ns()
    timestamp=datetime.datetime.fromtimestamp(timestamp_ns/1_000_000_000,
                                               datetime.timezone.utc).isoformat(timespec="microseconds").replace("+00:00","Z")
    record={"approved_by_uid":uid,"archived_at":timestamp,"archived_at_unix_ns":timestamp_ns,
            "assurance":manifest["deployment-assurance"],"commit":manifest["commit"],"files":files,
            "product_version":manifest["product-version"],"release_id":identifier,"schema":1,
            "source_state_sha256":manifest["source-state-sha256"],"stamp":manifest["stamp"]}
    record_raw=canonical(record); validate_record_shape(record,identifier)
    staging=os.path.join(releases,".release-staging."+secrets.token_hex(16))
    os.mkdir(staging,0o700); files_dir=os.path.join(staging,"files"); os.mkdir(files_dir,0o700)
    for item in files:
        create_file(os.path.join(files_dir,item["name"]),payloads[item["name"]],item["mode"])
    create_file(os.path.join(staging,"record.json"),record_raw,0o600)
    fsync_directory(files_dir); fsync_directory(staging)
    os.rename(staging,os.path.join(releases,"release-"+identifier)); fsync_directory(releases)
    validate_release(identifier)
    print(canonical({"created":True,"record_sha256":hashlib.sha256(record_raw).hexdigest(),
                     "release_id":identifier,"schema":1}).decode(),end="")
elif action=="plan":
    if len(arguments)!=2: fail("plan requires TARGET_RELEASE_ID and absolute output path")
    target,out=arguments; current,_,_,_=current_inventory()
    if current==target: fail("rollback target equals current release")
    target_record,record_raw,_=validate_release(target)
    timestamp_ns=time.time_ns()
    timestamp=datetime.datetime.fromtimestamp(timestamp_ns/1_000_000_000,
                                               datetime.timezone.utc).isoformat(timespec="microseconds").replace("+00:00","Z")
    body={"created_at":timestamp,"created_at_unix_ns":timestamp_ns,"current_release_id":current,
          "schema":1,"target_record_sha256":hashlib.sha256(record_raw).hexdigest(),
          "target_release_id":target,
          "target_rollback_semantics":rollback_semantics(
              targets_for_names([item["name"] for item in target_record["files"]]))}
    plan=dict(body); plan["plan_digest"]=hashlib.sha256(b"kist-rollback-plan-v1\0"+canonical(body)).hexdigest()
    atomic_output(out,canonical(plan))
    print(canonical({"current_release_id":current,"plan":out,"plan_digest":plan["plan_digest"],
                     "schema":1,"target_release_id":target,
                     "target_rollback_semantics":plan["target_rollback_semantics"]}).decode(),end="")
elif action=="stage":
    if len(arguments)!=2: fail("stage requires PLAN and full plan digest")
    plan=validate_plan(arguments[0],arguments[1])
    current,_,_,_=current_inventory()
    if current!=plan["current_release_id"]: fail("current deployment changed after rollback planning")
    _,record_raw,payloads=validate_release(plan["target_release_id"],True)
    if hashlib.sha256(record_raw).hexdigest()!=plan["target_record_sha256"]:
        fail("target release record changed after rollback planning")
    record_files=json.loads(record_raw)["files"]
    targets=targets_for_names([item["name"] for item in record_files])
    if plan["target_rollback_semantics"]!=rollback_semantics(targets):
        fail("rollback plan semantics do not match the target archive")
    staged=[]
    try:
        for name in targets:
            path=os.path.join(bindir,".kist-rollback-stage."+secrets.token_hex(16))
            mode=next(item["mode"] for item in record_files if item["name"]==name)
            create_file(path,payloads[name],mode); staged.append(path)
        fsync_directory(bindir)
    except BaseException:
        for path in staged:
            try: os.unlink(path)
            except FileNotFoundError: pass
        raise
    print("target-release-id="+plan["target_release_id"])
    for name,path in zip(targets,staged): print(name+"="+path)
else:
    fail("unknown registry action")
PY
  registry_status=$?
  [ "$registry_status" -eq 0 ] || return "$registry_status"
  case "$registry_action" in
    status|list|plan) require_deployment_lease ;;
    *) require_deployment_lease exclusive ;;
  esac
}
trap 'release_deployment_lease' 0
trap 'exit 130' 2
trap 'exit 143' 15

if [ "${1-}" = "--test-hold-deployment-lease" ]; then
  [ "${KIST_REBUILD_TESTING-}" = 1 ] && [ "$INSTALL_HOME" != /Users/lukekist ] \
    || die "deployment lease test hooks are forbidden for production"
  [ "$#" -eq 3 ] || die "--test-hold-deployment-lease requires ABSOLUTE_READY ABSOLUTE_RELEASE"
  case "$2:$3" in /*:/*) ;; *) die "deployment lease test paths must be absolute" ;; esac
  acquire_deployment_lease exclusive
  python_clean - "$2" "$3" <<'PY' || die "deployment lease test coordination failed"
