ready,release=sys.argv[1:]; uid=os.geteuid()
try:
    os.fstat(9)
except OSError as error:
    if error.errno!=errno.EBADF: raise
else:
    raise SystemExit(1)
for path in (ready,release):
    parent=os.path.dirname(path); leaf=os.path.basename(path)
