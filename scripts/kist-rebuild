#!/bin/sh -p
# Build and lease-serialize a journaled promotion from one explicit or provenance-bound checkout.
# Multi-file visibility is not globally atomic for readers outside the lease; failures roll back.
# No sibling-directory scan is permitted: a stale or partial deployment must fail closed.
set -eu
umask 077
unset ENV BASH_ENV CDPATH

INSTALL_HOME=/Users/lukekist
GIT=/usr/bin/git
PYTHON=/usr/bin/python3
SHASUM=/usr/bin/shasum
SWIFT=/usr/bin/swift
SAFE_PATH=/usr/bin:/bin:/usr/sbin:/sbin
PATH=$SAFE_PATH
HOME=$INSTALL_HOME
export PATH HOME
DASHBOARD_LAUNCHER="$INSTALL_HOME/bin/kist-dashboard"
DASHBOARD_REBUILD="$INSTALL_HOME/bin/kist-rebuild"
DASHBOARD_RUNTIME="$INSTALL_HOME/.kist/scripts/kist_runtime.py"
# Build snapshots and suite logs live below one owner-private per-installation directory.  Never
# enumerate a shared sticky directory for stale names: a different local UID must not be able to
# wedge recovery by reserving one of our fixed-format names.
SNAPSHOT_PARENT="$INSTALL_HOME/.kist-rebuild-private-tmp"
# The exact unsigned candidate used by enterprise evidence belongs to Kist, not SwiftPM's mutable
# convenience layout (`.build/release` is normally a symlink). Both publication and finalization
# traverse this fixed namespace with no-follow directory descriptors.
UNSIGNED_PROVENANCE_DIR=.kist-provenance

die() { echo "error: $*" >&2; exit 1; }
[ -x "$PYTHON" ] && [ ! -L "$PYTHON" ] || die "trusted system python is unavailable"
[ -x "$SWIFT" ] && [ ! -L "$SWIFT" ] || die "trusted system Swift is unavailable"

python_clean() {
  /usr/bin/env -i HOME="$INSTALL_HOME" PATH="$SAFE_PATH" LANG=C LC_ALL=C \
    TMPDIR=/private/tmp PYTHONNOUSERSITE=1 "$PYTHON" -I "$@" 9>&-
}

swift_clean() {
  /usr/bin/env -i HOME="$INSTALL_HOME" PATH="$SAFE_PATH" LANG=C LC_ALL=C \
    TMPDIR=/private/tmp "$SWIFT" "$@" 9>&-
}

is_kist_repo() {
  [ -f "$1/Package.swift" ] \
    && [ -f "$1/Sources/Kist/KistRunner.swift" ] \
    && [ -f "$1/Sources/AgentCore/CaptainOrchestrator.swift" ] \
    && [ -f "$1/Tests/KistTests/KistOptionsTests.swift" ] \
    && /usr/bin/grep -Fq '.executable(name: "kist"' "$1/Package.swift" 2>/dev/null
}

validated_repo() {
  case "$1" in /*) ;; *) return 1 ;; esac
  is_kist_repo "$1" || return 1
  (cd -P -- "$1" 2>/dev/null && pwd)
}

sha256_file() {
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  "$SHASUM" -a 256 "$1" | /usr/bin/awk '{print $1}'
}

stable_sha256_file() {
  python_clean - "$1" <<'PY'
import hashlib,os,stat,sys
path=sys.argv[1]; before=os.lstat(path)
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
identity=fp(before)
if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.geteuid()
        or before.st_nlink!=1 or before.st_mode&0o022 or before.st_size>262144):
    raise SystemExit(1)
fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW); digest=hashlib.sha256()
try:
    if fp(os.fstat(fd))!=identity: raise SystemExit(1)
    remaining=before.st_size
    while remaining:
        block=os.read(fd,min(1024*1024,remaining))
        if not block: raise SystemExit(1)
        digest.update(block); remaining-=len(block)
    if os.read(fd,1) or fp(os.fstat(fd))!=identity or fp(os.lstat(path))!=identity:
        raise SystemExit(1)
finally:
    os.close(fd)
print(digest.hexdigest())
PY
}

stage_stable_executable() {
  python_clean - "$1" "$2" <<'PY'
import hashlib,os,stat,sys
source,target=sys.argv[1:]
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
before=os.lstat(source); identity=fp(before)
if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.geteuid()
        or before.st_nlink!=1 or before.st_mode&0o022 or before.st_size>512*1024*1024):
    raise SystemExit(1)
target_before=os.lstat(target)
if (not stat.S_ISREG(target_before.st_mode) or target_before.st_uid!=os.geteuid()
        or target_before.st_nlink!=1 or target_before.st_mode&0o022
        or target_before.st_size!=0):
    raise SystemExit(1)
src=os.open(source,os.O_RDONLY|os.O_NOFOLLOW)
dst=os.open(target,os.O_WRONLY|os.O_NOFOLLOW)
digest=hashlib.sha256(); total=0
try:
    if fp(os.fstat(src))!=identity or fp(os.fstat(dst))!=fp(target_before): raise SystemExit(1)
    while True:
        block=os.read(src,1024*1024)
        if not block: break
        offset=0
        while offset<len(block):
            written=os.write(dst,block[offset:])
            if written<=0: raise SystemExit(1)
            offset+=written
        digest.update(block); total+=len(block)
    if (total!=before.st_size or os.read(src,1) or fp(os.fstat(src))!=identity
            or fp(os.lstat(source))!=identity):
        raise SystemExit(1)
    os.fchmod(dst,0o755); os.fsync(dst)
finally:
    os.close(src); os.close(dst)
print(digest.hexdigest())
PY
}

publish_unsigned_artifact() {
  python_clean - "$1" "$2" "$UNSIGNED_PROVENANCE_DIR" <<'PY'
import hashlib,os,re,secrets,stat,sys
root,source,namespace=sys.argv[1:]; uid=os.geteuid()
if os.path.realpath(root)!=root: raise SystemExit(1)
if namespace!=".kist-provenance": raise SystemExit(1)
MAX_RETAINED=64; MAX_RETAINED_BYTES=8*1024*1024*1024
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
def open_directory_at(parent,name,create=False):
    try: named=os.stat(name,dir_fd=parent,follow_symlinks=False)
    except FileNotFoundError:
        if not create: raise
        os.mkdir(name,0o700,dir_fd=parent)
        named=os.stat(name,dir_fd=parent,follow_symlinks=False)
    if not stat.S_ISDIR(named.st_mode) or named.st_uid!=uid or named.st_mode&0o022:
        raise SystemExit(1)
    fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent)
    if dfp(os.fstat(fd))!=dfp(named): os.close(fd); raise SystemExit(1)
    return fd,dfp(named)
rst=os.lstat(root)
if not stat.S_ISDIR(rst.st_mode) or rst.st_uid!=uid or rst.st_mode&0o022:
    raise SystemExit(1)
rfd=os.open(root,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
temp=".unsigned-kist."+secrets.token_hex(16); sfd=None; dfd=None; bfd=None; out=None
try:
    if dfp(os.fstat(rfd))!=dfp(rst): raise SystemExit(1)
    bfd,bid=open_directory_at(rfd,".build",True)
    dfd,did=open_directory_at(bfd,namespace,True)
    before=os.lstat(source); identity=fp(before)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=uid or before.st_nlink!=1
            or before.st_mode&0o022 or before.st_size>512*1024*1024):
        raise SystemExit(1)
    sfd=os.open(source,os.O_RDONLY|os.O_NOFOLLOW)
    if fp(os.fstat(sfd))!=identity: raise SystemExit(1)
    out=os.open(temp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o700,dir_fd=dfd)
    digest=hashlib.sha256(); total=0
    while True:
        block=os.read(sfd,1024*1024)
        if not block: break
        offset=0
        while offset<len(block):
            written=os.write(out,block[offset:])
            if written<=0: raise SystemExit(1)
            offset+=written
        digest.update(block); total+=len(block)
    if total!=before.st_size or fp(os.fstat(sfd))!=identity or fp(os.lstat(source))!=identity:
        raise SystemExit(1)
    target=digest.hexdigest(); count=0; retained_bytes=0; removed=False; retained_meta=[]
    for name in os.listdir(dfd):
        if name==temp: continue
        if re.fullmatch(r"\.unsigned-kist\.[0-9a-f]{32}",name):
            stale=os.stat(name,dir_fd=dfd,follow_symlinks=False)
            if (not stat.S_ISREG(stale.st_mode) or stale.st_uid!=uid or stale.st_nlink!=1
                    or stale.st_mode&0o022):
                raise SystemExit(1)
            os.unlink(name,dir_fd=dfd); removed=True
        elif re.fullmatch(r"[0-9a-f]{64}",name):
            if name==target: continue
            retained=os.stat(name,dir_fd=dfd,follow_symlinks=False)
            if (not stat.S_ISREG(retained.st_mode) or retained.st_uid!=uid
                    or retained.st_nlink!=1 or retained.st_mode&0o022
                    or retained.st_size>512*1024*1024):
                raise SystemExit(1)
            count+=1; retained_bytes+=retained.st_size
            retained_meta.append((retained.st_mtime_ns,name,retained.st_size))
        else:
            raise SystemExit(1)
    # AUTO-EVICT oldest-first instead of wedging every deploy at the cap (2026-08-08: with no
    # eviction, once 64 SHA artifacts accumulated EVERY deploy died here). These are build-time
    # provenance evidence, not the deployed binary (rollback uses the v3 release archives), so
    # dropping the oldest to make room for the one being published is safe. Same fail-closed
    # security posture: re-stat under the dir fd with O_NOFOLLOW and re-check the exact identity
    # before unlink — never widen what we delete.
    retained_meta.sort()  # oldest mtime first
    idx=0
    while (count+1>MAX_RETAINED or retained_bytes+before.st_size>MAX_RETAINED_BYTES) and idx<len(retained_meta):
        _,victim,vsize=retained_meta[idx]; idx+=1
        if victim==target: continue
        vst=os.stat(victim,dir_fd=dfd,follow_symlinks=False)
        if (not stat.S_ISREG(vst.st_mode) or vst.st_uid!=uid or vst.st_nlink!=1
                or vst.st_mode&0o022 or vst.st_size!=vsize):
            raise SystemExit(1)
        os.unlink(victim,dir_fd=dfd); removed=True
        count-=1; retained_bytes-=vsize
    if removed: os.fsync(dfd)
    if count+1>MAX_RETAINED or retained_bytes+before.st_size>MAX_RETAINED_BYTES:
        raise SystemExit(1)
    os.fchmod(out,0o755); os.fsync(out)
    if (dfp(os.fstat(dfd))!=did
            or dfp(os.stat(namespace,dir_fd=bfd,follow_symlinks=False))!=did
            or dfp(os.fstat(bfd))!=bid
            or dfp(os.stat(".build",dir_fd=rfd,follow_symlinks=False))!=bid
            or dfp(os.fstat(rfd))!=dfp(rst)
            or dfp(os.lstat(root))!=dfp(rst)):
        raise SystemExit(1)
    os.replace(temp,target,src_dir_fd=dfd,dst_dir_fd=dfd)
    published=fp(os.fstat(out))
    if fp(os.stat(target,dir_fd=dfd,follow_symlinks=False))!=published:
        raise SystemExit(1)
    os.fsync(dfd)
    if (dfp(os.fstat(dfd))!=did
            or dfp(os.stat(namespace,dir_fd=bfd,follow_symlinks=False))!=did
            or dfp(os.fstat(bfd))!=bid
            or dfp(os.stat(".build",dir_fd=rfd,follow_symlinks=False))!=bid
            or dfp(os.fstat(rfd))!=dfp(rst)
            or dfp(os.lstat(root))!=dfp(rst)):
        raise SystemExit(1)
    print(digest.hexdigest())
finally:
    if out is not None: os.close(out)
    if sfd is not None: os.close(sfd)
    if dfd is not None:
        try: os.unlink(temp,dir_fd=dfd)
        except FileNotFoundError: pass
        os.close(dfd)
    if bfd is not None: os.close(bfd)
    os.close(rfd)
PY
}

retained_unsigned_artifact_sha256() {
  python_clean - "$1" "$2" "$UNSIGNED_PROVENANCE_DIR" <<'PY'
import hashlib,os,re,stat,sys
root,target,namespace=sys.argv[1:]; uid=os.geteuid()
if os.path.realpath(root)!=root: raise SystemExit(1)
if namespace!=".kist-provenance" or not re.fullmatch(r"[0-9a-f]{64}",target):
    raise SystemExit(1)
def fp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,
            value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)
def dfp(value):
    return (value.st_dev,value.st_ino,value.st_mode,value.st_uid)
def open_directory_at(parent,name):
    named=os.stat(name,dir_fd=parent,follow_symlinks=False)
    if not stat.S_ISDIR(named.st_mode) or named.st_uid!=uid or named.st_mode&0o022:
        raise SystemExit(1)
    fd=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent)
    if dfp(os.fstat(fd))!=dfp(named): os.close(fd); raise SystemExit(1)
    return fd,dfp(named)
rst=os.lstat(root)
if not stat.S_ISDIR(rst.st_mode) or rst.st_uid!=uid or rst.st_mode&0o022:
    raise SystemExit(1)
rfd=os.open(root,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
bfd=None; dfd=None; fd=None
try:
    if dfp(os.fstat(rfd))!=dfp(rst): raise SystemExit(1)
    bfd,bid=open_directory_at(rfd,".build")
    dfd,did=open_directory_at(bfd,namespace)
    before=os.stat(target,dir_fd=dfd,follow_symlinks=False); identity=fp(before)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=uid or before.st_nlink!=1
            or before.st_mode&0o022 or not before.st_mode&stat.S_IXUSR
            or before.st_size>512*1024*1024):
        raise SystemExit(1)
    fd=os.open(target,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=dfd)
    if fp(os.fstat(fd))!=identity: raise SystemExit(1)
    digest=hashlib.sha256(); remaining=before.st_size
    while remaining:
        block=os.read(fd,min(1024*1024,remaining))
        if not block: raise SystemExit(1)
        digest.update(block); remaining-=len(block)
    if (os.read(fd,1) or fp(os.fstat(fd))!=identity
            or fp(os.stat(target,dir_fd=dfd,follow_symlinks=False))!=identity
            or dfp(os.fstat(dfd))!=did
            or dfp(os.stat(namespace,dir_fd=bfd,follow_symlinks=False))!=did
            or dfp(os.fstat(bfd))!=bid
            or dfp(os.stat(".build",dir_fd=rfd,follow_symlinks=False))!=bid
            or dfp(os.fstat(rfd))!=dfp(rst)
            or dfp(os.lstat(root))!=dfp(rst)):
        raise SystemExit(1)
    value=digest.hexdigest()
    if value!=target: raise SystemExit(1)
    print(value)
finally:
    if fd is not None: os.close(fd)
    if dfd is not None: os.close(dfd)
    if bfd is not None: os.close(bfd)
    os.close(rfd)
PY
}

source_inventory() {
  python_clean - "$1" "${2-}" <<'PY'
import hashlib,os,stat,sys
root=os.path.realpath(sys.argv[1]); destination_arg=sys.argv[2]
destination=os.path.realpath(destination_arg) if destination_arg else None
MAX_FILE=512*1024*1024; MAX_TOTAL=2*1024*1024*1024; MAX_PATHS=32*1024*1024
def fp(s): return (s.st_dev,s.st_ino,s.st_mode,s.st_size,s.st_nlink,s.st_mtime_ns,s.st_ctime_ns)
# Every logical child directory is an input too: Package.swift and build tools are executable code
# and may branch on empty-directory existence or permission mode.  The snapshot root itself is a
# deliberately normalized 0700 privacy boundary, so records begin with its children.
entries=[]; visited=total=paths=0
destination_fd=None
if destination is not None:
    if destination!=destination_arg or destination==root or destination.startswith(root+"/"):
        raise SystemExit(1)
    dst=os.lstat(destination)
    if (not stat.S_ISDIR(dst.st_mode) or dst.st_uid!=os.geteuid()
            or stat.S_IMODE(dst.st_mode)!=0o700 or os.listdir(destination)):
        raise SystemExit(1)
    destination_fd=os.open(destination,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
    if fp(os.fstat(destination_fd))!=fp(dst): raise SystemExit(1)
def write_all(fd,data):
    offset=0
    while offset<len(data):
        written=os.write(fd,data[offset:])
        if written<=0: raise RuntimeError("short write")
        offset+=written
def read_file(parent,name,identity,size,target_parent=None):
    fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=parent)
    out=None
    try:
        if fp(os.fstat(fd))!=identity: raise RuntimeError("race")
        if target_parent is not None:
            out=os.open(name,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,
                        dir_fd=target_parent)
        digest=hashlib.sha256(); remaining=size
        while remaining:
            b=os.read(fd,min(1024*1024,remaining))
            if not b: raise RuntimeError("short")
            digest.update(b)
            if out is not None: write_all(out,b)
            remaining-=len(b)
        if os.read(fd,1) or fp(os.fstat(fd))!=identity or fp(os.stat(name,dir_fd=parent,follow_symlinks=False))!=identity: raise RuntimeError("race")
        if out is not None:
            os.fchmod(out,stat.S_IMODE(identity[2])); os.fsync(out)
        return digest.digest()
    finally:
        os.close(fd)
        if out is not None: os.close(out)
def walk(fd,prefix,target_fd=None):
    global visited,total,paths
    initial=fp(os.fstat(fd)); observed=[]
    with os.scandir(os.dup(fd)) as scan: names=sorted((e.name for e in scan),key=lambda x:x.encode())
    for name in names:
        rel=f"{prefix}/{name}" if prefix else name; visited+=1
        if visited>250000 or len(rel.encode())>16384: raise RuntimeError("inventory bound")
        st=os.stat(name,dir_fd=fd,follow_symlinks=False); identity=fp(st); observed.append((name,identity))
        # Root SwiftPM/Xcode build products and the two high-churn telemetry paths are not source.
        # `.build-local` is the repo's ignored alternate SwiftPM cache and may contain symlinks.
        # The rest of root .kist (notably agents/, plan.json, and checked-in learning policy) is a
        # runtime/build input and must be copied and hashed. Same-named paths nested elsewhere
        # remain source too.
        if not prefix and name==".git":
            if stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode): continue
            raise RuntimeError("git metadata has an invalid type")
        if rel==".kist/usage.jsonl":
            if stat.S_ISREG(st.st_mode): continue
            raise RuntimeError("usage telemetry has an invalid type")
        if rel==".kist/runs":
            if stat.S_ISDIR(st.st_mode): continue
            raise RuntimeError("run telemetry has an invalid type")
        if name in {".build",".build-local","DerivedData"}:
            # Build output at ANY depth is a regenerable artifact, never source — skip it (and never
            # descend, so a nested SwiftPM `.build/debug` symlink can't choke the source hasher). Was
            # `not prefix and …` (root-only), which let e.g. mcp-server/.build/debug fail the snapshot.
            if stat.S_ISDIR(st.st_mode): continue
            raise RuntimeError("build output has an invalid type")
        if stat.S_ISDIR(st.st_mode):
            rb=rel.encode(); paths+=len(rb)
            if paths>MAX_PATHS: raise RuntimeError("aggregate bound")
            entries.append((rb,b"D",stat.S_IMODE(st.st_mode),b""))
            child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
            target_child=None
            try:
                if fp(os.fstat(child))!=identity: raise RuntimeError("directory race")
                if target_fd is not None:
                    os.mkdir(name,0o700,dir_fd=target_fd)
                    target_child=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,
                                         dir_fd=target_fd)
                walk(child,rel,target_child)
                if target_child is not None:
                    os.fchmod(target_child,stat.S_IMODE(st.st_mode)); os.fsync(target_child)
                if fp(os.fstat(child))!=identity or fp(os.stat(name,dir_fd=fd,follow_symlinks=False))!=identity: raise RuntimeError("directory changed")
            finally:
                os.close(child)
                if target_child is not None: os.close(target_child)
        elif stat.S_ISREG(st.st_mode):
            rb=rel.encode(); total+=st.st_size; paths+=len(rb)
            if st.st_size>MAX_FILE or total>MAX_TOTAL or paths>MAX_PATHS: raise RuntimeError("aggregate bound")
            entries.append((rb,b"F",stat.S_IMODE(st.st_mode),
                            read_file(fd,name,identity,st.st_size,target_fd)))
        else: raise RuntimeError(f"source symlink/special: {rel}")
    if fp(os.fstat(fd))!=initial: raise RuntimeError("directory changed")
    for name,identity in observed:
        if fp(os.stat(name,dir_fd=fd,follow_symlinks=False))!=identity: raise RuntimeError("name changed")
parent=os.path.dirname(root); leaf=os.path.basename(root)
if not leaf: raise SystemExit(1)
pfd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); parent_id=fp(os.fstat(pfd))
try:
    root_named=fp(os.stat(leaf,dir_fd=pfd,follow_symlinks=False))
    fd=os.open(leaf,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=pfd)
    try:
        if fp(os.fstat(fd))!=root_named: raise RuntimeError("root race")
        walk(fd,"",destination_fd)
        if fp(os.fstat(fd))!=root_named or fp(os.stat(leaf,dir_fd=pfd,follow_symlinks=False))!=root_named or fp(os.fstat(pfd))!=parent_id: raise RuntimeError("root changed")
    finally: os.close(fd)
finally: os.close(pfd)
entries.sort(key=lambda x:(x[0],x[1])); digest=hashlib.sha256(b"kist-source-state-v2\0")
for path,kind,mode,payload in entries:
    digest.update(len(path).to_bytes(8,"big"));digest.update(path);digest.update(kind);digest.update(mode.to_bytes(4,"big"));digest.update(len(payload).to_bytes(8,"big"));digest.update(payload)
if destination_fd is not None:
    os.fsync(destination_fd); os.close(destination_fd)
print(digest.hexdigest())
PY
}
source_state() {
  source_inventory "$1"
}
snapshot_source() {
  source_inventory "$1" "$2"
}
remove_source_snapshot() {
  [ -n "${1-}" ] || return 0
  python_clean - "$1" "$SNAPSHOT_PARENT" <<'PY'
import ctypes,errno,os,re,stat,sys
path,parent=sys.argv[1:]; uid=os.geteuid()
leaf=os.path.basename(path)
if (os.path.dirname(path)!=parent or os.path.realpath(parent)!=parent
        or not re.fullmatch(r"kist-source-snapshot\.[A-Za-z0-9]{6}",leaf)):
    raise SystemExit(1)
try: value=os.lstat(path)
except FileNotFoundError: raise SystemExit(0)
def identity(item): return (item.st_dev,item.st_ino,item.st_mode,item.st_uid)
if (not stat.S_ISDIR(value.st_mode) or value.st_uid!=uid
        or stat.S_IMODE(value.st_mode)!=0o700 or os.path.realpath(path)!=path):
    raise SystemExit(1)
pfd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
libc=ctypes.CDLL(None,use_errno=True)
libc.acl_get_fd_np.argtypes=[ctypes.c_int,ctypes.c_int]
libc.acl_get_fd_np.restype=ctypes.c_void_p
libc.acl_free.argtypes=[ctypes.c_void_p]
def has_acl(fd):
    ctypes.set_errno(0); acl=libc.acl_get_fd_np(fd,256)
    if acl:
        libc.acl_free(acl); return True
    if ctypes.get_errno() in {errno.ENOENT,errno.EINVAL,errno.ENOTSUP}: return False
    raise SystemExit(1)
def same_directory(left,right):
    return (stat.S_ISDIR(left.st_mode) and stat.S_ISDIR(right.st_mode)
            and (left.st_dev,left.st_ino,left.st_uid)==(right.st_dev,right.st_ino,right.st_uid))
def remove_tree(parent_fd,name,root_dev,root=False):
    named=os.stat(name,dir_fd=parent_fd,follow_symlinks=False); named_id=identity(named)
    if (not stat.S_ISDIR(named.st_mode) or named.st_uid!=uid or named.st_dev!=root_dev
            or (root and stat.S_IMODE(named.st_mode)!=0o700)):
        raise SystemExit(1)
    directory=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=parent_fd)
    try:
        opened=os.fstat(directory)
        rebound=os.stat(name,dir_fd=parent_fd,follow_symlinks=False)
        if identity(opened)!=named_id or identity(rebound)!=named_id or (root and has_acl(directory)):
            raise SystemExit(1)
        # Snapshot children deliberately preserve source directory modes, including read-only
        # 0555/0550 directories.  Rebind the opened descriptor to its still-identical name before
        # changing only this owner-private snapshot inode; otherwise unlink/rmdir can fail after a
        # successful deployment.  All later checks use the new descriptor/name identity.
        os.fchmod(directory,0o700)
        writable=os.fstat(directory)
        rebound=os.stat(name,dir_fd=parent_fd,follow_symlinks=False)
        writable_id=identity(writable)
        if (not same_directory(writable,named) or identity(rebound)!=writable_id
                or stat.S_IMODE(writable.st_mode)!=0o700):
            raise SystemExit(1)
        with os.scandir(os.dup(directory)) as scan:
            names=sorted((entry.name for entry in scan),key=lambda item:item.encode())
        for child_name in names:
            child=os.stat(child_name,dir_fd=directory,follow_symlinks=False)
            if child.st_uid!=uid or child.st_dev!=root_dev: raise SystemExit(1)
            if stat.S_ISDIR(child.st_mode):
                remove_tree(directory,child_name,root_dev)
            elif (stat.S_ISREG(child.st_mode) or stat.S_ISLNK(child.st_mode)
                  or stat.S_ISFIFO(child.st_mode) or stat.S_ISSOCK(child.st_mode)):
                if not stat.S_ISLNK(child.st_mode) and child.st_nlink!=1: raise SystemExit(1)
                os.unlink(child_name,dir_fd=directory)
            else:
                raise SystemExit(1)
        if (identity(os.fstat(directory))!=writable_id
                or identity(os.stat(name,dir_fd=parent_fd,follow_symlinks=False))!=writable_id):
            raise SystemExit(1)
    finally: os.close(directory)
    os.rmdir(name,dir_fd=parent_fd)
try:
    remove_tree(pfd,leaf,value.st_dev,True)
    os.fsync(pfd)
finally: os.close(pfd)
PY
}

# Validate one retained enterprise evidence bundle. The bundle contains the evidence bytes, not
# merely caller-supplied digests, and is deliberately described as local-candidate provenance: it
# is not a SLSA attestation. Output is a small canonical key=value projection for manifest creation.
enterprise_evidence_evaluate() {
  python_clean - "$1" "$2" "$3" <<'PY'
import base64,binascii,hashlib,json,os,stat,sys,xml.etree.ElementTree as ET
bundle_path,manifest_path,binary_path=sys.argv[1:]
HEX=set("0123456789abcdef")
BASE_REQUIRED={
 "schema","stamp","deployed","worktree","branch","commit","remote-origin-sha256","repository-id",
 "source-dirty","source-state-sha256","binary-sha256","wrapper-sha256","dashboard-launcher-sha256",
 "rebuild-sha256","safe-rebuild-sha256","artifact-closure-sha256","artifact-closure-count","test-evidence",
 "deployment-assurance","provenance-kind","unsigned-release-sha256","signed-installed-sha256","signing-type",
 "signing-identity","notarization-status","notarization-submission-id","notarization-package-sha256",
 "deployment-evidence-sha256","product-version",
}
ENTERPRISE_REQUIRED={
 "candidate-manifest-sha256","full-suite-evidence-sha256","full-suite-test-count","full-suite-failures",
 "full-suite-errors","five-canary-evidence-sha256","five-canary-count","five-canary-failures","sbom-sha256",
 "sbom-format","enterprise-evidence-sha256",
}
def valid_hash(value): return type(value) is str and len(value)==64 and all(c in HEX for c in value)
def stable_read(path,limit,executable=False):
    if not os.path.isabs(path) or os.path.realpath(path)!=path: raise SystemExit(1)
    before=os.lstat(path)
    if (not stat.S_ISREG(before.st_mode) or before.st_uid!=os.geteuid() or before.st_nlink!=1
            or before.st_mode&0o022 or before.st_size>limit or (executable and not before.st_mode&stat.S_IXUSR)):
        raise SystemExit(1)
    identity=(before.st_dev,before.st_ino,before.st_mode,before.st_uid,before.st_size,before.st_nlink,before.st_mtime_ns,before.st_ctime_ns)
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)
    try:
        current=os.fstat(fd)
        if (current.st_dev,current.st_ino,current.st_mode,current.st_uid,current.st_size,current.st_nlink,current.st_mtime_ns,current.st_ctime_ns)!=identity: raise SystemExit(1)
        chunks=[]; remaining=before.st_size
        while remaining:
            block=os.read(fd,min(1024*1024,remaining))
            if not block: raise SystemExit(1)
            chunks.append(block); remaining-=len(block)
        if os.read(fd,1): raise SystemExit(1)
        current=os.fstat(fd); named=os.lstat(path)
        for value in (current,named):
            if (value.st_dev,value.st_ino,value.st_mode,value.st_uid,value.st_size,value.st_nlink,value.st_mtime_ns,value.st_ctime_ns)!=identity: raise SystemExit(1)
        return b"".join(chunks)
    finally: os.close(fd)
def fields(raw):
    try: text=raw.decode("utf-8")
    except UnicodeDecodeError: raise SystemExit(1)
    if not text.endswith("\n") or "\r" in text: raise SystemExit(1)
    result={}
    for line in text.splitlines():
        if not line or ":" not in line: raise SystemExit(1)
        key,value=line.split(":",1); key=key.strip().lower(); value=value.strip()
        if not key or not value or key in result: raise SystemExit(1)
        result[key]=value
    return result
def decode(value,limit):
    if type(value) is not str or len(value)>((limit+2)//3)*4+4: raise SystemExit(1)
    try: raw=base64.b64decode(value.encode("ascii"),validate=True)
    except (UnicodeEncodeError,binascii.Error): raise SystemExit(1)
    if len(raw)>limit or base64.b64encode(raw).decode("ascii")!=value: raise SystemExit(1)
    return raw
def natural(value,positive=False):
    if type(value) is not int or isinstance(value,bool) or value<0 or (positive and value==0): raise SystemExit(1)
    return value
def digest(raw,claimed):
    if not valid_hash(claimed) or hashlib.sha256(raw).hexdigest()!=claimed: raise SystemExit(1)

manifest_raw=stable_read(manifest_path,262144)
current=fields(manifest_raw)
if current.get("schema")!="4" or current.get("deployment-assurance") not in {"pilot","enterprise"}: raise SystemExit(1)
expected=BASE_REQUIRED|(ENTERPRISE_REQUIRED if current["deployment-assurance"]=="enterprise" else set())
if set(current)!=expected or current.get("provenance-kind")!="local-candidate": raise SystemExit(1)
import re
semver=r"(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?"
if not re.fullmatch(semver,current.get("product-version","")): raise SystemExit(1)
for key in ["source-state-sha256","unsigned-release-sha256","signed-installed-sha256","binary-sha256","deployment-evidence-sha256"]:
    if not valid_hash(current.get(key)): raise SystemExit(1)
if current["signed-installed-sha256"]!=current["binary-sha256"]: raise SystemExit(1)
if current.get("notarization-status")=="accepted":
    if not re.fullmatch(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",current.get("notarization-submission-id","")) or not valid_hash(current.get("notarization-package-sha256")): raise SystemExit(1)
elif current.get("notarization-status")!="not-accepted" or current.get("notarization-submission-id")!="none" or current.get("notarization-package-sha256")!="none": raise SystemExit(1)
binary=stable_read(binary_path,512*1024*1024,True)
if hashlib.sha256(binary).hexdigest()!=current["signed-installed-sha256"]: raise SystemExit(1)

bundle_raw=stable_read(bundle_path,64*1024*1024)
try: bundle=json.loads(bundle_raw)
except (UnicodeDecodeError,json.JSONDecodeError): raise SystemExit(1)
if type(bundle) is not dict or set(bundle)!={"schema","assurance","provenance_kind","source_state_sha256","unsigned_release_sha256","signed_installed_sha256","candidate_manifest_sha256","candidate_manifest_base64","full_suite","five_canaries","sbom"}: raise SystemExit(1)
if bundle.get("schema")!=1 or bundle.get("assurance")!="enterprise" or bundle.get("provenance_kind")!="local-candidate": raise SystemExit(1)
canonical=(json.dumps(bundle,sort_keys=True,separators=(",",":"),ensure_ascii=True)+"\n").encode()
if canonical!=bundle_raw: raise SystemExit(1)
for key in ["source_state_sha256","unsigned_release_sha256","signed_installed_sha256","candidate_manifest_sha256"]:
    if not valid_hash(bundle.get(key)): raise SystemExit(1)
if bundle["source_state_sha256"]!=current["source-state-sha256"] or bundle["unsigned_release_sha256"]!=current["unsigned-release-sha256"] or bundle["signed_installed_sha256"]!=current["signed-installed-sha256"]: raise SystemExit(1)

candidate_raw=decode(bundle["candidate_manifest_base64"],262144); digest(candidate_raw,bundle["candidate_manifest_sha256"])
candidate=fields(candidate_raw)
if set(candidate)!=BASE_REQUIRED or candidate.get("schema")!="4" or candidate.get("deployment-assurance")!="pilot" or candidate.get("provenance-kind")!="local-candidate": raise SystemExit(1)
for key in BASE_REQUIRED-{"deployment-assurance","test-evidence","deployment-evidence-sha256"}:
    if current.get(key)!=candidate.get(key): raise SystemExit(1)
if current["deployment-assurance"]=="pilot" and candidate_raw!=manifest_raw: raise SystemExit(1)
if current["deployment-assurance"]=="enterprise" and current.get("candidate-manifest-sha256")!=bundle["candidate_manifest_sha256"]: raise SystemExit(1)

suite=bundle["full_suite"]
if type(suite) is not dict or set(suite)!={"content_base64","sha256","tests","failures","errors"}: raise SystemExit(1)
suite_raw=decode(suite["content_base64"],32*1024*1024); digest(suite_raw,suite["sha256"])
if b"<!DOCTYPE" in suite_raw.upper() or b"<!ENTITY" in suite_raw.upper(): raise SystemExit(1)
try: xml=ET.fromstring(suite_raw)
except ET.ParseError: raise SystemExit(1)
nodes=[xml] if xml.tag.rsplit("}",1)[-1]=="testsuite" else [node for node in list(xml) if node.tag.rsplit("}",1)[-1]=="testsuite"]
if not nodes: raise SystemExit(1)
def xml_count(node,name):
    value=node.attrib.get(name,"0")
    if not value.isdigit() or str(int(value))!=value: raise SystemExit(1)
    return int(value)
xml_tests=sum(xml_count(node,"tests") for node in nodes); xml_failures=sum(xml_count(node,"failures") for node in nodes); xml_errors=sum(xml_count(node,"errors") for node in nodes)
if natural(suite["tests"],True)!=xml_tests or natural(suite["failures"])!=xml_failures or natural(suite["errors"])!=xml_errors or xml_failures or xml_errors: raise SystemExit(1)

canary=bundle["five_canaries"]
if type(canary) is not dict or set(canary)!={"content_base64","sha256","count","failures"}: raise SystemExit(1)
canary_raw=decode(canary["content_base64"],1024*1024); digest(canary_raw,canary["sha256"])
try: canary_doc=json.loads(canary_raw)
except (UnicodeDecodeError,json.JSONDecodeError): raise SystemExit(1)
if type(canary_doc) is not dict or set(canary_doc)!={"schema","binary_sha256","source_state_sha256","canaries"} or canary_doc.get("schema")!=1: raise SystemExit(1)
if (json.dumps(canary_doc,sort_keys=True,separators=(",",":"),ensure_ascii=True)+"\n").encode()!=canary_raw: raise SystemExit(1)
if canary_doc.get("binary_sha256")!=current["signed-installed-sha256"] or canary_doc.get("source_state_sha256")!=current["source-state-sha256"]: raise SystemExit(1)
expected_names={"observe","whole-computer","local-research","fetch-only","live-tavily"}; records=canary_doc.get("canaries")
if type(records) is not list or len(records)!=5: raise SystemExit(1)
names=set()
for record in records:
    if type(record) is not dict or set(record)!={"name","status"} or record.get("name") not in expected_names or record.get("status")!="pass" or record["name"] in names: raise SystemExit(1)
    names.add(record["name"])
if names!=expected_names or natural(canary["count"])!=5 or natural(canary["failures"])!=0: raise SystemExit(1)

sbom=bundle["sbom"]
if type(sbom) is not dict or set(sbom)!={"content_base64","sha256","format"} or sbom.get("format")!="cyclonedx-1.7-json": raise SystemExit(1)
sbom_raw=decode(sbom["content_base64"],8*1024*1024); digest(sbom_raw,sbom["sha256"])
try: sbom_doc=json.loads(sbom_raw)
except (UnicodeDecodeError,json.JSONDecodeError): raise SystemExit(1)
if type(sbom_doc) is not dict or sbom_doc.get("bomFormat")!="CycloneDX" or sbom_doc.get("specVersion")!="1.7": raise SystemExit(1)
metadata=sbom_doc.get("metadata"); properties=metadata.get("properties") if type(metadata) is dict else None
if type(properties) is not list: raise SystemExit(1)
bound={}
trusted={"kist:source-state-sha256","kist:unsigned-release-sha256","kist:product-version"}
for item in properties:
    if type(item) is dict and item.get("name") in trusted:
        if set(item)!={"name","value"} or item["name"] in bound or type(item.get("value")) is not str: raise SystemExit(1)
        bound[item["name"]]=item["value"]
if bound!={"kist:source-state-sha256":current["source-state-sha256"],"kist:unsigned-release-sha256":current["unsigned-release-sha256"],"kist:product-version":current["product-version"]}: raise SystemExit(1)

bundle_hash=hashlib.sha256(bundle_raw).hexdigest()
projection={
 "candidate-manifest-sha256":bundle["candidate_manifest_sha256"],
 "full-suite-evidence-sha256":suite["sha256"],"full-suite-test-count":str(suite["tests"]),
 "full-suite-failures":str(suite["failures"]),"full-suite-errors":str(suite["errors"]),
 "five-canary-evidence-sha256":canary["sha256"],"five-canary-count":"5","five-canary-failures":"0",
 "sbom-sha256":sbom["sha256"],"sbom-format":"cyclonedx-1.7-json",
 "enterprise-evidence-sha256":bundle_hash,"deployment-evidence-sha256":bundle_hash,
}
if current["deployment-assurance"]=="enterprise":
    for key,value in projection.items():
        if current.get(key)!=value: raise SystemExit(1)
for key in sorted(projection): print(f"{key}={projection[key]}")
PY
}

# Report the actual code-signing and Gatekeeper state. Identity values are public certificate
# metadata; keychain material and notarization credentials are never read or printed.
signing_state() {
  python_clean - "$1" <<'PY'
import os,subprocess,sys
path=sys.argv[1]
if not os.path.isabs(path) or os.path.realpath(path)!=path: raise SystemExit(1)
try:
    verification=subprocess.run(
        ["/usr/bin/codesign","--verify","--strict","--all-architectures",path],
        stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=15)
except (OSError,subprocess.TimeoutExpired):
    raise SystemExit(1)
if verification.returncode: raise SystemExit(1)
codesign=subprocess.run(["/usr/bin/codesign","-d","--verbose=4",path],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.PIPE,timeout=15)
if codesign.returncode: raise SystemExit(1)
try: lines=codesign.stderr.decode("utf-8").splitlines()
except UnicodeDecodeError: raise SystemExit(1)
signature=next((line.split("=",1)[1] for line in lines if line.startswith("Signature=")),"")
authorities=[line.split("=",1)[1] for line in lines if line.startswith("Authority=")]
if signature=="adhoc": kind,identity="ad-hoc","adhoc"
elif authorities and authorities[0].startswith("Developer ID Application:"): kind,identity="developer-id",authorities[0]
else: kind,identity="other",(authorities[0] if authorities else "unknown")
if not identity or len(identity)>512 or any(ord(c)<32 or ord(c)==127 for c in identity): raise SystemExit(1)
notarization="not-accepted"
try:
    gate=subprocess.run(["/usr/sbin/spctl","--assess","--type","execute","--verbose=4",path],stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=20)
    report=(gate.stdout+gate.stderr).decode("utf-8","replace")
    if gate.returncode==0 and "source=Notarized Developer ID" in report: notarization="accepted"
except (OSError,subprocess.TimeoutExpired): pass
print("signing-type="+kind); print("signing-identity="+identity); print("notarization-status="+notarization)
PY
}

# Read-only evidence plumbing is available before any deployment lease, network access, build, or
# mutation. CI uses the exact production source-state implementation to bind its test invocation.
if [ "${1-}" = "--print-source-state" ]; then
  [ "$#" -le 2 ] || die "usage: kist-rebuild --print-source-state [ABSOLUTE_REPO]"
  PRINT_ROOT=${2:-$PWD}
  PRINT_ROOT=$(validated_repo "$PRINT_ROOT") || die "source-state root is not one canonical Kist repo"
  source_state "$PRINT_ROOT" || die "cannot compute source state"
  exit 0
fi
if [ "${1-}" = "--test-snapshot-source" ]; then
  [ "${KIST_REBUILD_TESTING-}" = 1 ] && [ "$INSTALL_HOME" != /Users/lukekist ] \
    || die "source snapshot test seam is unavailable in production"
  [ "$#" -eq 3 ] || die "--test-snapshot-source requires ABSOLUTE_REPO ABSOLUTE_EMPTY_DESTINATION"
  SNAPSHOT_TEST_ROOT=$(validated_repo "$2") || die "snapshot test root is not one canonical Kist repo"
  case "$3" in /*) ;; *) die "snapshot test destination must be absolute" ;; esac
  snapshot_source "$SNAPSHOT_TEST_ROOT" "$3" || die "source snapshot test failed"
  exit 0
fi
if [ "${1-}" = "--test-publish-unsigned-artifact" ]; then
  [ "${KIST_REBUILD_TESTING-}" = 1 ] && [ "$INSTALL_HOME" != /Users/lukekist ] \
    || die "unsigned artifact test seam is unavailable in production"
  [ "$#" -eq 3 ] || die "--test-publish-unsigned-artifact requires ABSOLUTE_REPO ABSOLUTE_SOURCE"
  UNSIGNED_TEST_ROOT=$(validated_repo "$2") \
    || die "unsigned artifact test root is not one canonical Kist repo"
  case "$3" in /*) ;; *) die "unsigned artifact test source must be absolute" ;; esac
  publish_unsigned_artifact "$UNSIGNED_TEST_ROOT" "$3" \
    || die "unsigned artifact publication test failed"
  exit 0
fi
if [ "${1-}" = "--test-hash-retained-unsigned-artifact" ]; then
  [ "${KIST_REBUILD_TESTING-}" = 1 ] && [ "$INSTALL_HOME" != /Users/lukekist ] \
    || die "unsigned artifact test seam is unavailable in production"
  [ "$#" -eq 3 ] \
    || die "--test-hash-retained-unsigned-artifact requires ABSOLUTE_REPO SHA256"
  UNSIGNED_TEST_ROOT=$(validated_repo "$2") \
    || die "unsigned artifact test root is not one canonical Kist repo"
  retained_unsigned_artifact_sha256 "$UNSIGNED_TEST_ROOT" "$3" \
    || die "retained unsigned artifact test failed"
  exit 0
fi
if [ "${1-}" = "--evidence-evaluate" ]; then
  [ "$#" -eq 4 ] || die "--evidence-evaluate requires BUNDLE MANIFEST BINARY"
  enterprise_evidence_evaluate "$2" "$3" "$4" || die "enterprise evidence is missing, stale, malformed, or inconsistent"
  exit 0
fi
if [ "${1-}" = "--signing-evaluate" ]; then
  [ "$#" -eq 2 ] || die "--signing-evaluate requires BINARY"
  signing_state "$2" || die "cannot inspect code-signing state"
  exit 0
fi

# Validate schema-3 compatibility deployments and every schema-4 field against canonical repository
# identity and installed artifacts. The only output on success is the canonical worktree.
deployed_repo() {
  python_clean - "$INSTALL_HOME" <<'PY'
import hashlib
import ctypes,errno,os
import stat
import selectors,signal,subprocess,time
import sys

home = os.path.realpath(sys.argv[1])
stamp_path = os.path.join(home, "bin", ".kist-build")
manifest_path = os.path.join(home, "bin", "kist-current.manifest")
binary_path = os.path.join(home, "bin", "kist-current")
wrapper_path = os.path.join(home, "bin", "kist")
launcher_path = os.path.join(home, "bin", "kist-dashboard")
rebuild_path = os.path.join(home, "bin", "kist-rebuild")
safe_rebuild_path = os.path.join(home, "bin", "kist-safe-rebuild.sh")
runtime_path = os.path.join(home, ".kist", "scripts", "kist_runtime.py")
evidence_path = os.path.join(home, "bin", "kist-current.provenance.json")
artifacts = [stamp_path, manifest_path, binary_path, wrapper_path, launcher_path, rebuild_path, runtime_path]
if any(not stat.S_ISREG(os.lstat(path).st_mode) for path in artifacts):
    raise SystemExit(1)

def fp(value):
    return (value.st_dev, value.st_ino, value.st_mode, value.st_uid, value.st_size,
            value.st_nlink, value.st_mtime_ns, value.st_ctime_ns)
libc=ctypes.CDLL(None,use_errno=True)
libc.acl_get_fd_np.argtypes=[ctypes.c_int,ctypes.c_int]
libc.acl_get_fd_np.restype=ctypes.c_void_p
libc.acl_free.argtypes=[ctypes.c_void_p]
def acl(fd):
    ctypes.set_errno(0); value=libc.acl_get_fd_np(fd,256)
    if value:
        libc.acl_free(value); return True
    if ctypes.get_errno() in {errno.ENOENT,errno.EINVAL,errno.ENOTSUP}:
        return False
    raise SystemExit(1)

def stable_read_bin(name: str, limit: int) -> str:
    parent=os.path.dirname(home); home_name=os.path.basename(home)
    pfd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW); pid=fp(os.fstat(pfd))
    try:
        hst=os.stat(home_name,dir_fd=pfd,follow_symlinks=False); hid=fp(hst)
        if not stat.S_ISDIR(hst.st_mode) or hst.st_uid!=os.geteuid() or hst.st_mode&0o022: raise SystemExit(1)
        hfd=os.open(home_name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=pfd)
        try:
            if fp(os.fstat(hfd))!=hid: raise SystemExit(1)
            bst=os.stat("bin",dir_fd=hfd,follow_symlinks=False); bid=fp(bst)
            if not stat.S_ISDIR(bst.st_mode) or bst.st_uid!=os.geteuid() or bst.st_mode&0o022: raise SystemExit(1)
            bfd=os.open("bin",os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=hfd)
            try:
                if fp(os.fstat(bfd))!=bid or acl(bfd): raise SystemExit(1)
                st=os.stat(name,dir_fd=bfd,follow_symlinks=False); before=fp(st)
                if (not stat.S_ISREG(st.st_mode) or st.st_uid!=os.geteuid() or st.st_nlink!=1
                        or st.st_mode&0o022 or st.st_size>limit): raise SystemExit(1)
                fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=bfd)
                try:
                    if fp(os.fstat(fd))!=before or acl(fd): raise SystemExit(1)
                    chunks=[]; total=0
                    while True:
                        block=os.read(fd,min(65536,limit-total+1))
                        if not block: break
                        total+=len(block)
                        if total>limit: raise SystemExit(1)
                        chunks.append(block)
                    if fp(os.fstat(fd))!=before or fp(os.stat(name,dir_fd=bfd,follow_symlinks=False))!=before: raise SystemExit(1)
                finally: os.close(fd)
                if fp(os.fstat(bfd))!=bid or fp(os.stat("bin",dir_fd=hfd,follow_symlinks=False))!=bid: raise SystemExit(1)
                if fp(os.fstat(hfd))!=hid or fp(os.stat(home_name,dir_fd=pfd,follow_symlinks=False))!=hid or fp(os.fstat(pfd))!=pid: raise SystemExit(1)
                return b"".join(chunks).decode("utf-8")
            finally: os.close(bfd)
        finally: os.close(hfd)
    finally: os.close(pfd)
