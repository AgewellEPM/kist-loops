        }
      ]
    },
    {
      "id": "ghostbridge_provenance",
      "description": "Read-only GhostBridge frozen provenance, deployed signatures/configuration, runtime parity, and explicit drift evidence.",
      "steps": [
        {
          "id": "ghostbridge-frozen-baseline",
          "kind": "command",
          "safety": "read_only",
          "cwd": "${GHOSTBRIDGE_REPO}/Tools/Portal",
          "argv": ["/usr/bin/shasum", "-a", "256", "-c", "baseline.sha256"],
          "resumePolicy": "rerun",
          "resumeBindings": ["${GHOSTBRIDGE_REPO}/Tools/Portal/baseline.sha256"],
          "timeoutSeconds": 60,
          "expect": {"exitCodes": [0]}
        },
        {
          "id": "ghostbridge-isolated-configured-signature",
          "kind": "command",
          "safety": "read_only",
          "cwd": "${HOME}",
          "argv": ["/usr/bin/codesign", "--verify", "--strict", "--verbose=2", "${HOME}/.kist/mcp/isolated-tester/bin/isolated-mcp"],
          "resumePolicy": "rerun",
          "resumeBindings": ["${HOME}/.kist/mcp/isolated-tester/bin/isolated-mcp"],
          "timeoutSeconds": 60,
          "expect": {"exitCodes": [0]}
        },
        {
          "id": "ghostbridge-isolated-local-signature",
          "kind": "command",
          "safety": "read_only",
          "cwd": "${HOME}",
          "argv": ["/usr/bin/codesign", "--verify", "--strict", "--verbose=2", "${HOME}/.local/bin/isolated-mcp"],
          "resumePolicy": "rerun",
          "resumeBindings": ["${HOME}/.local/bin/isolated-mcp"],
          "timeoutSeconds": 60,
          "expect": {"exitCodes": [0]}
        },
        {
          "id": "ghostbridge-tinkystream-signature",
          "kind": "command",
          "safety": "read_only",
          "cwd": "${HOME}",
